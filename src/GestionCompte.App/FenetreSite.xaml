<Window x:Class="GestionCompte.App.FenetreSite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Nom du site" Style="{StaticResource Discret}" Margin="0,0,0,3" />
        <TextBox x:Name="Nom" Height="28" MaxLength="60" />
        <TextBlock Text="Adresse de recherche" Style="{StaticResource Discret}" Margin="0,10,0,3" />
        <TextBox x:Name="Adresse" Height="28" />
        <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Faites une recherche sur le site (par exemple « TEST »), copiez l'adresse de la page de résultats et remplacez le mot cherché par {recherche}. Exemple : https://www.exemple.fr/recherche?q={recherche}" />
        <TextBlock x:Name="Probleme" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="OK" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0" Click="Valider" />
        </StackPanel>
    </StackPanel>
</Window>

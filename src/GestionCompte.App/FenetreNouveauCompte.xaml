<Window x:Class="GestionCompte.App.FenetreNouveauCompte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau compte" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Nouveau compte" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Aide}"
                   Text="Un compte par compte bancaire (autre banque, livret, compte joint…). Chaque compte a sa propre configuration, ses mois et son prévisionnel." />

        <TextBlock Text="Nom du compte :" Margin="0,4,0,4" />
        <TextBox x:Name="Nom" Height="28" MaxLength="60" />

        <TextBlock Text="Configuration de départ :" Margin="0,14,0,4" />
        <ComboBox x:Name="Modele" />
        <TextBlock Style="{StaticResource Aide}" Margin="0,6,0,0"
                   Text="La copie reprend les revenus, charges, enveloppes, comptes cumulés et règles, sans les mois ni le solde de départ." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="Créer le compte" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0"
                    Click="Creer" />
        </StackPanel>
    </StackPanel>
</Window>

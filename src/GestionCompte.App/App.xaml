<Application x:Class="GestionCompte.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GestionCompte.App"
             xmlns:vues="clr-namespace:GestionCompte.App.Vues"
             xmlns:vm="clr-namespace:GestionCompte.Presentation;assembly=GestionCompte.Presentation"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <local:MontantConvertisseur x:Key="Montant" />
        <local:EurosConvertisseur x:Key="Euros" />
        <BooleanToVisibilityConverter x:Key="Visible" />

        <SolidColorBrush x:Key="Accent" Color="#1F5FAD" />
        <SolidColorBrush x:Key="AccentClair" Color="#E8F0FA" />
        <SolidColorBrush x:Key="Fond" Color="#F4F6F9" />
        <SolidColorBrush x:Key="Bordure" Color="#D5DBE3" />
        <SolidColorBrush x:Key="TexteDiscret" Color="#5F6B7A" />
        <SolidColorBrush x:Key="Negatif" Color="#C0392B" />
        <SolidColorBrush x:Key="Positif" Color="#1E7D45" />

        <!-- Encadré blanc utilisé pour chaque bloc d'un écran. -->
        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="6" />
        </Style>

        <Style x:Key="TitreCarte" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Aide" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TexteDiscret}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="28" />
        </Style>

        <Style x:Key="BoutonPrincipal" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6EAF0" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="26" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource AccentClair}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <!-- Montants alignés à droite dans les tableaux. -->
        <Style x:Key="CelluleMontant" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="EditionMontant" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <Style x:Key="CelluleTexte" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <DataTemplate DataType="{x:Type vm:MoisViewModel}">
            <vues:VueMois />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ConfigurationViewModel}">
            <vues:VueConfiguration />
        </DataTemplate>
    </Application.Resources>
</Application>

<Window x:Class="GestionCompte.App.FenetreCleIA"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="Explication" TextWrapping="Wrap" Margin="0,0,0,10" />
        <Button x:Name="BoutonLien" HorizontalAlignment="Left" Padding="14,6" Click="OuvrirLien" />
        <TextBlock x:Name="LibelleCle" Text="Clé API" Style="{StaticResource Discret}" Margin="0,14,0,3" />
        <PasswordBox x:Name="Cle" Height="28" Padding="4,3" VerticalContentAlignment="Center"
                     Background="{DynamicResource Saisie}" Foreground="{DynamicResource Texte}" BorderBrush="{DynamicResource Bordure}" />
        <TextBlock x:Name="LibelleModele" Style="{StaticResource Discret}" Margin="0,10,0,3" />
        <TextBox x:Name="Modele" Height="28" />
        <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                   Text="La clé reste sur ce PC, chiffrée par Windows. Seul ce que vous demandez (le nom d'un produit, par exemple) est envoyé à l'IA. Le modèle peut rester vide (modèle gratuit conseillé)." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="Enregistrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0" Click="Valider" />
        </StackPanel>
    </StackPanel>
</Window>

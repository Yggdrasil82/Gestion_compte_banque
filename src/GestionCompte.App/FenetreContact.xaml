<Window x:Class="GestionCompte.App.FenetreContact"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="Nom" Style="{StaticResource Discret}" Margin="0,0,0,3" />
        <TextBox x:Name="Nom" Height="28" MaxLength="100" />
        <TextBlock Text="Adresse mail" Style="{StaticResource Discret}" Margin="0,10,0,3" />
        <TextBox x:Name="Email" Height="28" MaxLength="200" />
        <TextBlock Text="Notes (organisme, n° de contrat…)" Style="{StaticResource Discret}" Margin="0,10,0,3" />
        <TextBox x:Name="Notes" Height="28" MaxLength="200" />
        <TextBlock x:Name="Probleme" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="OK" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0" Click="Valider" />
        </StackPanel>
    </StackPanel>
</Window>

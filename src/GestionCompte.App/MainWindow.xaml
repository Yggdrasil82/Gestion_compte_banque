<Window x:Class="GestionCompte.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion Compte Banque"
        Width="1400" Height="860" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Fond}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Padding="4,2">
            <MenuItem Header="_Fichier">
                <MenuItem Header="_Enregistrer une copie des données…" Command="{Binding SauvegarderCopieCommand}" />
                <MenuItem Header="_Restaurer une sauvegarde…" Command="{Binding RestaurerCommand}" />
                <Separator />
                <MenuItem Header="_Ouvrir le dossier des données" Command="{Binding OuvrirDossierDonneesCommand}" />
                <Separator />
                <MenuItem Header="_Quitter" Click="Quitter_Click" />
            </MenuItem>
            <MenuItem Header="_Mois">
                <MenuItem Header="_Appliquer la configuration au mois affiché…" Command="{Binding AppliquerConfigurationCommand}" />
                <MenuItem Header="_Supprimer le dernier mois…" Command="{Binding SupprimerDernierMoisCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Bordure}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding Statut}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding CheminDonnees}" Foreground="{StaticResource TexteDiscret}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding OngletSelectionne}" Margin="6" Padding="0" Background="{StaticResource Fond}">
            <TabItem Header="  Mois  " FontSize="14">
                <DockPanel TextElement.FontSize="13">
                    <!-- Barre de navigation entre les mois. -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" Padding="10,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Content="◀" Command="{Binding MoisPrecedentCommand}" ToolTip="Mois précédent" />
                                <TextBlock Text="{Binding TitreMois}" FontSize="22" FontWeight="SemiBold" MinWidth="230"
                                           TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                                <Button Content="▶" Command="{Binding MoisSuivantCommand}" ToolTip="Mois suivant" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Appliquer la configuration…" Command="{Binding AppliquerConfigurationCommand}"
                                        ToolTip="Met à jour ce mois avec les montants de la configuration" />
                                <Button Content="{Binding TexteCreerMois}" Command="{Binding CreerMoisCommand}"
                                        Style="{StaticResource BoutonPrincipal}" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <ContentControl Content="{Binding MoisCourant}" />
                        <Border Style="{StaticResource Carte}" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="30"
                                Margin="0,60,0,0" Visibility="{Binding AucunMois, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Aucun mois pour l'instant" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Aide}" TextAlignment="Center" Margin="0,8,0,16" MaxWidth="420"
                                           Text="Vérifiez vos revenus, enveloppes et charges dans l'onglet « Configuration », puis créez votre premier mois." />
                                <Button Content="{Binding TexteCreerMois}" Command="{Binding CreerMoisCommand}"
                                        Style="{StaticResource BoutonPrincipal}" HorizontalAlignment="Center" Padding="16,8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="  Configuration  " FontSize="14">
                <ContentControl Content="{Binding Configuration}" FontSize="13" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

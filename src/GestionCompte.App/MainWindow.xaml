<Window x:Class="GestionCompte.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GestionCompte.Presentation;assembly=GestionCompte.Presentation"
        Title="Gestion Compte Banque"
        Icon="/Ressources/icone.ico"
        Width="1400" Height="880" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Fond}"
        Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColonneBarre" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre de gauche : navigation, apparence, données. -->
        <Border Grid.Column="0" Background="{DynamicResource Barre}" BorderBrush="{DynamicResource Bordure}" BorderThickness="0,0,1,0">
            <!-- Petits écrans : la barre défile pour atteindre le bas (Apparence, Données) ; sinon le bas reste collé en bas. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Border Padding="12,16,12,12"
                    MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <DockPanel Margin="8,0,0,16">
                        <!-- Réduire la barre aux icônes, ou la remettre en entier. -->
                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonBarre}" Command="{Binding Apparence.BasculerBarreCommand}"
                                Padding="7,6" Margin="0" VerticalAlignment="Top" ToolTip="Réduire la barre aux icônes, ou l'afficher en entier">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE700;" FontSize="13" />
                        </Button>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Apparence.BarreReduite, Converter={StaticResource MasqueSiVrai}}">
                            <Image Source="/Ressources/icone.png" Width="34" Height="34" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Mon Budget" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BarreTexte}" />
                                <TextBlock Text="{Binding Version}" FontSize="11" Opacity="0.7" Foreground="{DynamicResource BarreTexte}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Visibility="{Binding Apparence.BarreReduite, Converter={StaticResource MasqueSiVrai}}">
                        <!-- Choix du compte (un compte par banque, livret…). -->
                        <StackPanel Margin="8,0,8,16" Visibility="{Binding GestionComptes, Converter={StaticResource Visible}}">
                            <TextBlock Text="COMPTE" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="0,0,0,6"
                                       Foreground="{DynamicResource BarreTexte}" />
                            <ComboBox ItemsSource="{Binding NomsComptes}" SelectedItem="{Binding CompteActif}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Style="{StaticResource BoutonBarre}" Command="{Binding NouveauCompteCommand}" ToolTip="Nouveau compte…"
                                        Padding="8,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                                        <TextBlock Text="Nouveau" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BoutonBarre}" Command="{Binding RenommerCompteCommand}" ToolTip="Renommer ce compte…"
                                        Padding="8,5">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE70F;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource BoutonBarre}" Command="{Binding SupprimerCompteCommand}" ToolTip="Supprimer ce compte…"
                                        Padding="8,5">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Modules rangés par thèmes (accordéon) ; affichage et ordre propres au compte ouvert (rangés depuis MainWindow.xaml.cs). -->
                    <Button Style="{StaticResource TitreTheme}" Command="{Binding Apparence.BasculerThemeCommand}" CommandParameter="Budget"
                            Tag="{Binding Apparence.ThemeBudgetOuvert}" ToolTip="Budget : ouvrir ou fermer">
                        <TextBlock Text="BUDGET" />
                    </Button>
                    <StackPanel x:Name="BarreBudget" Visibility="{Binding Apparence.ThemeBudgetOuvert, Converter={StaticResource Visible}}">
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Mois"
                                     Tag="&#xE787;" Background="{DynamicResource Accent1}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Prévisionnel"
                                     Tag="&#xEAFC;" Background="{DynamicResource Accent4}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Aide au budget"
                                     Tag="&#xEA80;" Background="{DynamicResource Accent2}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=2}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Bilan" Content="Bilan"
                                     Tag="&#xE9D2;" Background="{DynamicResource Accent1}"
                                     Visibility="{Binding Apparence.ModuleBilan, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=7}" />
                    </StackPanel>
                    <Button Style="{StaticResource TitreTheme}" Command="{Binding Apparence.BasculerThemeCommand}" CommandParameter="Finances"
                            Tag="{Binding Apparence.ThemeFinancesOuvert}" ToolTip="Finances : ouvrir ou fermer"
                            Visibility="{Binding Apparence.ThemeFinancesVisible, Converter={StaticResource Visible}}">
                        <TextBlock Text="FINANCES" />
                    </Button>
                    <StackPanel x:Name="BarreFinances" Visibility="{Binding Apparence.ThemeFinancesOuvert, Converter={StaticResource Visible}}">
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Credits" Content="Crédits"
                                     Tag="&#xE8C7;" Background="{DynamicResource Accent4}"
                                     Visibility="{Binding Apparence.ModuleCredits, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=6}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Prets" Content="Prêts"
                                     Tag="&#xE80F;" Background="{DynamicResource Accent2}"
                                     ToolTip="Prêts en cours : tableau d'amortissement, remboursement anticipé"
                                     Visibility="{Binding Apparence.ModulePrets, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=13}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Bourse" Content="Bourse"
                                     Tag="&#xE9D2;" Background="{DynamicResource Accent1}"
                                     ToolTip="Placements en bourse (Trade Republic) : positions, plus-values, cours"
                                     Visibility="{Binding Apparence.ModuleBourse, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=15}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Impots" Content="Impôts"
                                     Tag="&#xE8EF;" Background="{DynamicResource Accent3}"
                                     ToolTip="Estimation de l'impôt sur le revenu à partir de tous les comptes, et pistes pour le réduire"
                                     Visibility="{Binding Apparence.ModuleImpots, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=17}" />
                    </StackPanel>
                    <Button Style="{StaticResource TitreTheme}" Command="{Binding Apparence.BasculerThemeCommand}" CommandParameter="Outils"
                            Tag="{Binding Apparence.ThemeOutilsOuvert}" ToolTip="Outils : ouvrir ou fermer"
                            Visibility="{Binding Apparence.ThemeOutilsVisible, Converter={StaticResource Visible}}">
                        <TextBlock Text="OUTILS" />
                    </Button>
                    <StackPanel x:Name="BarreOutils" Visibility="{Binding Apparence.ThemeOutilsOuvert, Converter={StaticResource Visible}}">
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Documents" Content="{Binding Documents.TitreNavigation}"
                                     Tag="&#xE8F1;" Background="{DynamicResource Accent2}"
                                     ToolTip="Documents importants : pièces d'identité, contrats, factures, échéances"
                                     Visibility="{Binding Apparence.ModuleDocuments, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=8}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Mail" Content="Mail"
                                     Tag="&#xE715;" Background="{DynamicResource Accent1}"
                                     ToolTip="Envoyer un mail avec des documents ou le bilan en pièce jointe"
                                     Visibility="{Binding Apparence.ModuleMail, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=9}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Achats" Content="{Binding Achats.TitreNavigation}"
                                     Tag="&#xE7BF;" Background="{DynamicResource Accent3}"
                                     ToolTip="Aide à l'achat : meilleur prix par les IA, sites, prix suivis"
                                     Visibility="{Binding Apparence.ModuleAchats, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=10}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Lettres" Content="Lettres"
                                     Tag="&#xE70B;" Background="{DynamicResource Accent2}"
                                     ToolTip="Lettres types rédigées par les IA : PDF, Word ou mail"
                                     Visibility="{Binding Apparence.ModuleLettres, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=11}" />
                        <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Uid="Assistant" Content="Assistant"
                                     Tag="&#xE8BD;" Background="{DynamicResource Accent1}"
                                     ToolTip="Questions sur votre budget aux IA (ne modifie rien)"
                                     Visibility="{Binding Apparence.ModuleAssistant, Converter={StaticResource Visible}}"
                                     IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=12}" />
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource BarreTexte}" Opacity="0.15" Margin="8,4,8,8" />
                    <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Vue d'ensemble"
                                 Tag="&#xE80A;" Background="{DynamicResource Positif}"
                                 Visibility="{Binding PlusieursComptes, Converter={StaticResource Visible}}"
                                 IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=5}" />
                    <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Configuration"
                                 Tag="&#xE713;" Background="{DynamicResource Accent3}"
                                 IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=3}" />
                    <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="Aide"
                                 Tag="&#xE897;" Background="{DynamicResource Accent4}"
                                 ToolTip="Manuel d'utilisation, avec une recherche"
                                 IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=14}" />
                    <RadioButton Style="{StaticResource Navigation}" GroupName="Navigation" Content="{Binding Suggestions.TitreNavigation}"
                                 Tag="&#xE8F2;" Background="{DynamicResource Accent2}"
                                 ToolTip="Suggestions envoyées par les utilisateurs (formulaire Google)"
                                 Visibility="{Binding Suggestions.OngletDisponible, Converter={StaticResource Visible}}"
                                 IsChecked="{Binding OngletSelectionne, Converter={StaticResource Egal}, ConverterParameter=16}" />
                    <StackPanel Visibility="{Binding Apparence.BarreReduite, Converter={StaticResource MasqueSiVrai}}">
                        <Button Style="{StaticResource BoutonBarre}" Command="{Binding Suggestions.SuggererCommand}" Margin="0,4,0,0"
                                ToolTip="Proposer une amélioration de l'application (formulaire en ligne, sans compte)"
                                Visibility="{Binding Suggestions.FormulaireDisponible, Converter={StaticResource Visible}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE82F;" Margin="0,0,8,0" />
                                <TextBlock Text="Suggérer une amélioration" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Visibility="{Binding Apparence.BarreReduite, Converter={StaticResource MasqueSiVrai}}">
                    <TextBlock Text="APPARENCE" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="8,0,0,6"
                               Foreground="{DynamicResource BarreTexte}" />
                    <ComboBox ItemsSource="{x:Static vm:ApparenceViewModel.Ambiances}" DisplayMemberPath="Nom" SelectedValuePath="Valeur"
                              SelectedValue="{Binding Apparence.Ambiance}" Margin="8,0,8,8" />
                    <CheckBox Content="Mode sombre" IsChecked="{Binding Apparence.ModeSombre}" IsEnabled="{Binding Apparence.ModeSombreModifiable}"
                              Foreground="{DynamicResource BarreTexte}" Margin="10,0,0,18"
                              ToolTip="L'ambiance Nuit est toujours sombre." />

                    <TextBlock Text="DONNÉES" FontSize="11" FontWeight="SemiBold" Opacity="0.7" Margin="8,0,0,6"
                               Foreground="{DynamicResource BarreTexte}" />
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding ImporterReleveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE8B5;" Margin="0,0,10,0" />
                            <TextBlock Text="Importer un relevé…" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding TexteDernierImport}" TextWrapping="Wrap" FontSize="11" Opacity="0.75" Margin="38,-2,8,6"
                               Foreground="{DynamicResource BarreTexte}"
                               ToolTip="Téléchargez le prochain relevé sur le site de la banque à partir de cette date"
                               Visibility="{Binding AvecDernierImport, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding SauvegarderCopieCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE74E;" Margin="0,0,10,0" />
                            <TextBlock Text="Enregistrer une copie…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding SauvegarderToutCommand}"
                            ToolTip="Tous les comptes, les préférences et le coffre de Documents dans un seul fichier .zip (sans les clés ni mots de passe)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE8F1;" Margin="0,0,10,0" />
                            <TextBlock Text="Sauvegarder tout…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding RestaurerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE777;" Margin="0,0,10,0" />
                            <TextBlock Text="Restaurer une sauvegarde…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding RestaurerToutCommand}"
                            ToolTip="Remplace tous les comptes et le coffre de Documents par une sauvegarde de tout (.zip)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE777;" Margin="0,0,10,0" />
                            <TextBlock Text="Restaurer tout…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding OuvrirDossierDonneesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE838;" Margin="0,0,10,0" />
                            <TextBlock Text="Ouvrir le dossier" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonBarre}" Command="{Binding ReinitialiserCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE72C;" Margin="0,0,10,0" />
                            <TextBlock Text="Réinitialiser…" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border />
            </DockPanel>
            </Border>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Statut}" Style="{StaticResource Discret}" FontSize="12"
                       Margin="22,0,22,8" TextTrimming="CharacterEllipsis" />

            <Grid Margin="12,12,12,4">
                <!-- Écran Mois -->
                <DockPanel Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=0}">
                    <!-- Bandeau coloré : navigation entre les mois et actions. -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="16,12" Margin="6,6,6,4">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding MoisPrecedentCommand}" ToolTip="Mois précédent"
                                        Padding="0" Width="34" Height="34">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE76B;" />
                                </Button>
                                <!-- Titre du mois : liste déroulante de tous les mois créés. -->
                                <ComboBox Style="{StaticResource ListeEntete}" ItemsSource="{Binding ListeMois}" SelectedItem="{Binding MoisSelectionne}"
                                          DisplayMemberPath="Libelle" ToolTip="Choisir un mois"
                                          MinWidth="240" Margin="8,0" VerticalAlignment="Center" MaxDropDownHeight="420" />
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding MoisSuivantCommand}" ToolTip="Mois suivant"
                                        Padding="0" Width="34" Height="34">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE76C;" />
                                </Button>
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding AllerAuMoisEnCoursCommand}"
                                        ToolTip="Revenir au mois en cours" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE8D1;" Margin="0,0,8,0" />
                                        <TextBlock Text="Aujourd'hui" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding ImporterReleveCommand}"
                                        ToolTip="Importer un relevé bancaire (OFX ou QIF) et pointer les opérations">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE8B5;" Margin="0,0,8,0" />
                                        <TextBlock Text="Relevé" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding AppliquerConfigurationCommand}"
                                        ToolTip="Met à jour ce mois avec les montants de la configuration">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE895;" Margin="0,0,8,0" />
                                        <TextBlock Text="Appliquer la configuration" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding ExporterMoisCommand}"
                                        ToolTip="Exporter ce mois vers Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE896;" Margin="0,0,8,0" />
                                        <TextBlock Text="Excel" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BoutonEntete}" Command="{Binding SupprimerDernierMoisCommand}"
                                        ToolTip="Supprimer le dernier mois" Padding="0" Width="34" Height="34">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" />
                                </Button>
                                <Button Style="{StaticResource BoutonEnteteBlanc}" Command="{Binding CreerMoisCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding TexteCreerMois}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <ContentControl Content="{Binding MoisCourant}" />
                        <Border Style="{StaticResource Carte}" VerticalAlignment="Top" HorizontalAlignment="Center" Padding="32"
                                Margin="0,60,0,0" Visibility="{Binding AucunMois, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <TextBlock Text="Aucun mois pour l'instant" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Style="{StaticResource Aide}" TextAlignment="Center" Margin="0,8,0,16" MaxWidth="420"
                                           Text="Vérifiez vos revenus, enveloppes et charges dans « Configuration », puis créez votre premier mois." />
                                <Button Content="{Binding TexteCreerMois}" Command="{Binding CreerMoisCommand}"
                                        Style="{StaticResource BoutonPrincipal}" HorizontalAlignment="Center" Padding="18,9" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- Écran Prévisionnel -->
                <ContentControl Content="{Binding Previsionnel}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=1}" />

                <!-- Écran Aide au budget -->
                <ContentControl Content="{Binding AideBudget}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=2}" />

                <!-- Module Bilan -->
                <ContentControl Content="{Binding Bilan}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=7}" />

                <!-- Module Documents (commun à tous les comptes) -->
                <ContentControl Content="{Binding Documents}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=8}" />

                <!-- Module Mail (commun à tous les comptes) -->
                <ContentControl Content="{Binding Mail}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=9}" />

                <!-- Module Achats (commun à tous les comptes) -->
                <ContentControl Content="{Binding Achats}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=10}" />

                <!-- Module Lettres (commun à tous les comptes) -->
                <ContentControl Content="{Binding Lettres}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=11}" />

                <!-- Module Assistant -->
                <ContentControl Content="{Binding Assistant}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=12}" />

                <!-- Module Crédits -->
                <ContentControl Content="{Binding Credits}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=6}" />

                <!-- Module Prêts -->
                <ContentControl Content="{Binding Prets}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=13}" />

                <!-- Module Bourse -->
                <ContentControl Content="{Binding Bourse}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=15}" />
                <!-- Module Impôts -->
                <ContentControl Content="{Binding Impots}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=17}" />

                <!-- Suggestions reçues -->
                <ContentControl Content="{Binding Suggestions}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=16}" />

                <!-- Écran Configuration -->
                <ContentControl Content="{Binding Configuration}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=3}" />

                <!-- Vue d'ensemble de tous les comptes -->
                <ContentControl Content="{Binding Ensemble, Converter={StaticResource NouvelleVueEnsemble}}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=5}" />

                <!-- Manuel d'utilisation -->
                <ContentControl Content="{Binding ManuelUtilisation}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=14}" />

                <!-- Aperçu d'un import de relevé -->
                <ContentControl Content="{Binding Import}"
                                Visibility="{Binding OngletSelectionne, Converter={StaticResource VisibleSiEgal}, ConverterParameter=4}" />
            </Grid>
        </DockPanel>
    </Grid>
</Window>

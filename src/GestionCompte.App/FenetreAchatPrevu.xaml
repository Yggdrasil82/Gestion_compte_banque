<Window x:Class="GestionCompte.App.FenetreAchatPrevu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prévoir l'achat" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="L'achat est ajouté aux opérations prévues du compte ouvert : le prévisionnel montre aussitôt son effet sur le solde." />
        <TextBlock Text="Libellé" Style="{StaticResource Discret}" Margin="0,0,0,3" />
        <TextBox x:Name="Libelle" Height="28" MaxLength="120" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mois de l'achat" Style="{StaticResource Discret}" Margin="0,0,0,3" />
                <ComboBox x:Name="Mois" Height="28" DisplayMemberPath="Libelle" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Montant (€)" Style="{StaticResource Discret}" Margin="0,0,0,3" />
                <TextBox x:Name="Montant" Height="28" TextAlignment="Right" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Probleme" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="Ajouter au prévisionnel" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0" Click="Valider" />
        </StackPanel>
    </StackPanel>
</Window>

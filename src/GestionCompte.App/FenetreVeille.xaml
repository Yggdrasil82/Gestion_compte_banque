<Window x:Class="GestionCompte.App.FenetreVeille"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veille marchés" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="La veille est rangée chaque matin dans votre dépôt GitHub privé. Créez une clé limitée à ce dépôt, en lecture seule :" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="1. « Repository access » : « Only select repositories », puis le dépôt de la veille." />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,2" Text="2. « Permissions » : « Contents », « Read-only ». Rien d'autre." />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10" Text="3. « Generate token », puis copiez la clé et collez-la ci-dessous." />
        <Button Content="Créer une clé sur GitHub" HorizontalAlignment="Left" Padding="14,6" Click="OuvrirLien" />
        <TextBlock Text="Dépôt (propriétaire/nom)" Style="{StaticResource Discret}" Margin="0,14,0,3" />
        <TextBox x:Name="Depot" Height="28" />
        <TextBlock x:Name="LibelleCle" Text="Clé GitHub" Style="{StaticResource Discret}" Margin="0,10,0,3" />
        <PasswordBox x:Name="Cle" Height="28" Padding="4,3" VerticalContentAlignment="Center"
                     Background="{DynamicResource Saisie}" Foreground="{DynamicResource Texte}" BorderBrush="{DynamicResource Bordure}" />
        <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                   Text="La clé reste sur ce PC, chiffrée par Windows. Elle sert seulement à lire le fichier de la veille ; votre portefeuille n'est envoyé nulle part." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="Enregistrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0" Click="Valider" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="GestionCompte.App.FenetreMiseAJour"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour de Mon Budget" Width="560" Height="480" ResizeMode="CanResize" MinHeight="300" MinWidth="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="20" Foreground="{DynamicResource Accent1}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="Titre" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Actuelle" DockPanel.Dock="Top" Foreground="{DynamicResource TexteDiscret}" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Foreground="{DynamicResource TexteDiscret}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Text="L'application télécharge la nouvelle version, la met à la place de l'actuelle et redémarre. Vos données ne sont pas modifiées." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Plus tard" IsCancel="True" Padding="16,7" />
                <Button Content="Installer et redémarrer" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0"
                        Click="Installer" />
            </StackPanel>
        </StackPanel>

        <Border BorderBrush="{DynamicResource Bordure}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource FondCarte}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <TextBlock x:Name="Nouveautes" TextWrapping="Wrap" LineHeight="20" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>

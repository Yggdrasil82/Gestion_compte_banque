<Window x:Class="GestionCompte.App.FenetreReinitialisation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réinitialiser" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Option sous forme de carte cliquable. -->
        <Style x:Key="Option" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Texte}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cadre" Background="{DynamicResource FondCarte}" BorderBrush="{DynamicResource Bordure}"
                                BorderThickness="2" CornerRadius="10" Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource Accent1}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cadre" Property="BorderBrush" Value="{DynamicResource Accent1}" />
                                <Setter TargetName="Cadre" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Réinitialiser l'application" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Style="{StaticResource Aide}" Text="Choisissez ce qui doit être effacé. Une confirmation vous sera encore demandée." />

        <RadioButton x:Name="OptionMois" Style="{StaticResource Option}" GroupName="Choix" IsChecked="True">
            <StackPanel>
                <TextBlock Text="Effacer les mois (nouveau départ)" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Aide}" Margin="0,2,0,0"
                           Text="Les mois et les opérations prévues sont effacés. La configuration (charges, revenus, enveloppes, règles) et les objectifs sont gardés. Une copie de sécurité est faite automatiquement." />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="OptionTout" Style="{StaticResource Option}" GroupName="Choix">
            <StackPanel>
                <TextBlock Text="Tout effacer (nouvelle personne)" FontWeight="SemiBold" Foreground="{DynamicResource Negatif}" />
                <TextBlock Style="{StaticResource Aide}" Margin="0,2,0,0"
                           Text="Toutes les données sont définitivement effacées de ce PC, y compris les copies de sécurité automatiques. L'application repart d'une configuration vierge, sans aucune de vos informations." />
                <CheckBox x:Name="CopieAvant" IsChecked="True" Margin="0,4,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=OptionTout}"
                          Content="Enregistrer d'abord une copie de mes données (clé USB, disque externe…)" />
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="Continuer…" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0"
                    Click="Continuer" />
        </StackPanel>
    </StackPanel>
</Window>

<UserControl x:Class="GestionCompte.App.Vues.VuePrevisionnel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:GestionCompte.App"
             xmlns:vm="clr-namespace:GestionCompte.Presentation;assembly=GestionCompte.Presentation">
    <UserControl.Resources>
        <Style x:Key="Tuile" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="IconeTuile" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="LibelleTuile" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ValeurTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau : titre et durée de la simulation. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="18,12" Margin="6,6,6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="Simuler sur" Foreground="{DynamicResource EnteteTexte}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{x:Static vm:PrevisionnelViewModel.Horizons}" SelectedItem="{Binding Horizon}" Width="70" />
                    <TextBlock Text="mois" Foreground="{DynamicResource EnteteTexte}" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Prévisionnel" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource EnteteTexte}" />
                    <TextBlock Text="Les mois à venir sont simulés avec votre configuration et vos opérations prévues. Enveloppes comptées en entier."
                               Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="310" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Chiffres clés -->
            <UniformGrid Grid.Row="0" Grid.ColumnSpan="2" Columns="4">
                <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent1}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent1Clair}">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE787;" FontSize="18" Foreground="{DynamicResource Accent1}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding TitreSoldeFinal}" />
                            <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent1}"
                                       Text="{Binding SoldeFinal, Converter={StaticResource Euros}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent3}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent3Clair}">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE70D;" FontSize="18" Foreground="{DynamicResource Accent3}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding TitrePointBas}" MaxWidth="200" />
                            <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent3}"
                                       Text="{Binding SoldePointBas, Converter={StaticResource Euros}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent4}">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent4Clair}">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE734;" FontSize="18" Foreground="{DynamicResource Accent4}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding TitreEpargne}" />
                            <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent4}"
                                       Text="{Binding EpargneFinale, Converter={StaticResource Euros}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Alerte découvert : verte si aucun découvert, rouge sinon. -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Tuile}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Positif}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DecouvertPrevu}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Negatif}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent2Clair}">
                            <TextBlock FontSize="18">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icone}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DecouvertPrevu}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="210">
                            <TextBlock Style="{StaticResource LibelleTuile}" Text="Alerte découvert" />
                            <TextBlock Text="{Binding Alerte}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Graphique -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Border Width="18" Height="3" Background="{DynamicResource Accent1}" VerticalAlignment="Center" />
                            <TextBlock Text="réel" Style="{StaticResource Discret}" Margin="6,0,14,0" />
                            <TextBlock Text="• • •" Foreground="{DynamicResource Accent1}" FontWeight="Bold" />
                            <TextBlock Text="prévu" Style="{StaticResource Discret}" Margin="6,0,14,0" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Negatif}" VerticalAlignment="Center" />
                            <TextBlock Text="négatif" Style="{StaticResource Discret}" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                            <TextBlock Text="Solde de fin de mois" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <app:GraphiqueSoldes Lignes="{Binding Lignes}"
                                         Couleur="{DynamicResource Accent1}" CouleurNegative="{DynamicResource Negatif}"
                                         CouleurGrille="{DynamicResource Bordure}" CouleurTexte="{DynamicResource TexteDiscret}"
                                         CouleurFond="{DynamicResource FondCarte}" />
                </DockPanel>
            </Border>

            <!-- Échéances des comptes cumulés -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Carte}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                        <TextBlock Text="Objectifs et remboursements" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Aide}"
                               Text="Date à laquelle chaque compte cumulé atteint son objectif, au rythme de vos charges mensuelles. Les objectifs se règlent dans Configuration." />
                    <ItemsControl ItemsSource="{Binding Echeances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Accent4Clair}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" FontSize="18" Margin="0,0,12,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Icone}">
                                                    <Setter Property="Text" Value="&#xE823;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent4}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Atteinte}" Value="True">
                                                            <Setter Property="Text" Value="&#xE930;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Nom}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Texte}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Aide}" FontStyle="Italic"
                               Text="Aucun objectif défini pour l'instant.">
                        <TextBlock.Visibility>
                            <Binding Path="Echeances.Count" Converter="{StaticResource VisibleSiEgal}" ConverterParameter="0" />
                        </TextBlock.Visibility>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Tableau mois par mois -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Carte}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                        <TextBlock Text="Mois par mois" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Lignes}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mois" Binding="{Binding Libelle, Mode=OneWay}" Width="*" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleTexte}">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Type" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="9" Padding="9,1" HorizontalAlignment="Left" Margin="4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Accent4Clair}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Reel}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Accent1Clair}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Type}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent4}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Reel}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Accent1}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Entrées" Width="105" Binding="{Binding Entrees, Mode=OneWay, Converter={StaticResource Montant}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Sorties" Width="105" Binding="{Binding Sorties, Mode=OneWay, Converter={StaticResource Montant}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent3}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Écart" Width="100" Binding="{Binding Variation, Mode=OneWay, Converter={StaticResource Montant}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VariationNegative}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Solde fin" Width="115" Binding="{Binding SoldeFin, Mode=OneWay, Converter={StaticResource Montant}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Negatif}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Opérations ponctuelles prévues -->
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Button ToolTip="Ajouter une opération prévue" Command="{Binding OperationsPrevues.AjouterCommand}"
                                    Style="{StaticResource BoutonPrincipal}" Padding="0" Width="30" Height="28">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" />
                            </Button>
                            <Button ToolTip="Supprimer l'opération sélectionnée" Command="{Binding OperationsPrevues.SupprimerCommand}"
                                    Padding="0" Width="30" Height="28" Margin="0">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                            <TextBlock Text="Opérations ponctuelles prévues" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                               Text="Vacances, prime, taxe… Elles sont ajoutées automatiquement au mois quand vous le créez." />
                    <DataGrid ItemsSource="{Binding OperationsPrevues.Elements}" SelectedItem="{Binding OperationsPrevues.Selection}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Mois" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.Periodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Periode, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*"
                                                ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}" />
                            <DataGridTextColumn Header="Débit" Width="80"
                                                Binding="{Binding Debit, Converter={StaticResource Montant}, ConverterParameter=vide}"
                                                ElementStyle="{StaticResource CelluleMontant}" EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTextColumn Header="Crédit" Width="80"
                                                Binding="{Binding Credit, Converter={StaticResource Montant}, ConverterParameter=vide}"
                                                EditingElementStyle="{StaticResource EditionMontant}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

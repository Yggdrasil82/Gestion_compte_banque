<UserControl x:Class="GestionCompte.App.Vues.VueConfiguration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionCompte.Presentation;assembly=GestionCompte.Presentation">
    <UserControl.Resources>
        <!-- Boutons + / − / ▲ / ▼ d'une liste (le DataContext est la ListeEditable). -->
        <DataTemplate x:Key="BoutonsListe">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Ajouter" Command="{Binding AjouterCommand}" Padding="0" Width="28" Height="28">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" />
                </Button>
                <Button ToolTip="Supprimer la ligne sélectionnée" Command="{Binding SupprimerCommand}" Padding="0" Width="28" Height="28">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" FontSize="12" />
                </Button>
                <Button ToolTip="Monter" Command="{Binding MonterCommand}" Padding="0" Width="28" Height="28">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE70E;" FontSize="11" />
                </Button>
                <Button ToolTip="Descendre" Command="{Binding DescendreCommand}" Padding="0" Width="28" Height="28" Margin="0">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE70D;" FontSize="11" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Démarrage -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Carte}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                        <TextBlock Text="Démarrage" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Premier mois :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{x:Static vm:ConfigurationViewModel.NomsMois}" SelectedIndex="{Binding IndexMoisDebut}"
                                  IsEnabled="{Binding PremierMoisModifiable}" Width="120" />
                        <TextBox Text="{Binding AnneeDebut}" IsEnabled="{Binding PremierMoisModifiable}" Width="70" Margin="6,0,24,0"
                                 Height="26" />
                        <TextBlock Text="Solde du compte au départ :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SoldeInitial, Converter={StaticResource Montant}}" Width="110"
                                 TextAlignment="Right" Height="26" />
                        <TextBlock Text="€" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                               Text="Les montants ci-dessous servent de valeurs par défaut pour chaque nouveau mois. Pour mettre à jour un mois déjà créé, utilisez « Appliquer la configuration » dans l'onglet Mois." />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <!-- Revenus -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Revenus}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                                <TextBlock Text="Revenus" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Revenus.Elements}" SelectedItem="{Binding Revenus.Selection}" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Revenu" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTextColumn Header="Montant habituel" Width="130"
                                                    Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Enveloppes -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Enveloppes}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Avertissement}" />
                                <TextBlock Text="Enveloppes" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="Budgets de dépenses (courses, carburant…) : le budget est réservé dans le prévisionnel, les dépenses saisies dans l'enveloppe en sont déduites." />
                        <DataGrid ItemsSource="{Binding Enveloppes.Elements}" SelectedItem="{Binding Enveloppes.Selection}" MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Enveloppe" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTemplateColumn Header="Catégorie" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{x:Static vm:ConfigurationViewModel.Categories}"
                                                      SelectedItem="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Budget mensuel" Width="120"
                                                    Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1">
                <!-- Comptes cumulés -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding ComptesCumul}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                                <TextBlock Text="Comptes cumulés" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="Épargne, remboursements… : additionnent chaque mois les débits des charges et opérations qui leur sont liées. Objectif : montant total à atteindre (facultatif)." />
                        <DataGrid ItemsSource="{Binding ComptesCumul.Elements}" SelectedItem="{Binding ComptesCumul.Selection}" MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Compte" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTextColumn Header="Déjà cumulé" Width="110"
                                                    Binding="{Binding MontantInitial, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                                <DataGridTextColumn Header="Objectif" Width="110"
                                                    Binding="{Binding Objectif, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Règles de classement des relevés importés -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Regles}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                                <TextBlock Text="Règles de classement" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="À l'import d'un relevé, une dépense dont le libellé contient le mot-clé est rangée dans l'enveloppe choisie (majuscules et accents ignorés)." />
                        <DataGrid ItemsSource="{Binding Regles.Elements}" SelectedItem="{Binding Regles.Selection}" MinHeight="150" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mot-clé du libellé" Binding="{Binding MotCle}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTemplateColumn Header="Enveloppe" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource ListeCellule}"
                                                      ItemsSource="{Binding DataContext.NomsEnveloppes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Enveloppe, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Modules (réglage propre à ce PC) -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                            <TextBlock Text="Modules" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <CheckBox Content="Crédits : simulation et comparaison de crédits"
                                  IsChecked="{Binding DataContext.Apparence.ModuleCredits, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Style="{StaticResource Aide}" Margin="0,6,0,0"
                                   Text="Affiche ou masque l'onglet dans la barre de gauche. Réglage propre à ce PC : vos simulations sont conservées même si le module est masqué." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Charges -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ContentControl DockPanel.Dock="Right" Content="{Binding Charges}" ContentTemplate="{StaticResource BoutonsListe}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                            <TextBlock Text="Charges" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                               Text="Ajoutées automatiquement à chaque nouveau mois, dans cet ordre. Pour une charge qui ne passe pas tous les mois (poubelles tous les 2 mois…), choisissez sa fréquence et un mois où elle est prélevée : elle ne sera ajoutée que les mois concernés." />
                    <DataGrid ItemsSource="{Binding Charges.Elements}" SelectedItem="{Binding Charges.Selection}" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Charge" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                            <DataGridTextColumn Header="Débit" Width="80"
                                                Binding="{Binding Debit, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTextColumn Header="Crédit" Width="70"
                                                Binding="{Binding Credit, Converter={StaticResource Montant}, ConverterParameter=vide}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTemplateColumn Header="Catégorie" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{x:Static vm:ConfigurationViewModel.Categories}"
                                                  SelectedItem="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Fréquence" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{x:Static vm:ConfigurationViewModel.Frequences}"
                                                  SelectedItem="{Binding Frequence, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Prélevée en" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  Visibility="{Binding DepartModifiable, Converter={StaticResource Visible}}"
                                                  ItemsSource="{Binding DataContext.MoisDepart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Depart, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Un mois où la charge est prélevée ; les suivants s'en déduisent avec la fréquence." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Compte cumulé" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.NomsComptesCumul, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding CompteCumul, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

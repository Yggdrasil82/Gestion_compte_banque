<UserControl x:Class="GestionCompte.App.Vues.VueConfiguration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GestionCompte.Presentation;assembly=GestionCompte.Presentation">
    <UserControl.Resources>
        <!-- Boutons + / − / ▲ / ▼ d'une liste (le DataContext est la ListeEditable). -->
        <DataTemplate x:Key="BoutonsListe">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Ajouter" Command="{Binding AjouterCommand}" Padding="0" Width="28" Height="28">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" />
                </Button>
                <Button ToolTip="Supprimer la ligne sélectionnée" Command="{Binding SupprimerCommand}" Padding="0" Width="28" Height="28">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" FontSize="12" />
                </Button>
                <Button ToolTip="Monter" Command="{Binding MonterCommand}" Padding="0" Width="28" Height="28">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE70E;" FontSize="11" />
                </Button>
                <Button ToolTip="Descendre" Command="{Binding DescendreCommand}" Padding="0" Width="28" Height="28" Margin="0">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE70D;" FontSize="11" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Démarrage -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Carte}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                        <TextBlock Text="Démarrage" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Premier mois :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{x:Static vm:ConfigurationViewModel.NomsMois}" SelectedIndex="{Binding IndexMoisDebut}"
                                  IsEnabled="{Binding PremierMoisModifiable}" Width="120" />
                        <TextBox Text="{Binding AnneeDebut}" IsEnabled="{Binding PremierMoisModifiable}" Width="70" Margin="6,0,24,0"
                                 Height="26" />
                        <TextBlock Text="Solde du compte au départ :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SoldeInitial, Converter={StaticResource Montant}}" Width="110"
                                 TextAlignment="Right" Height="26" />
                        <TextBlock Text="€" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                               Text="Les montants ci-dessous servent de valeurs par défaut pour chaque nouveau mois. Pour mettre à jour un mois déjà créé, utilisez « Appliquer la configuration » dans l'onglet Mois." />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Grid.Column="0">
                <!-- Revenus -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Revenus}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                                <TextBlock Text="Revenus" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Revenus.Elements}" SelectedItem="{Binding Revenus.Selection}" MinHeight="120">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Revenu" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTextColumn Header="Montant habituel" Width="130"
                                                    Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Enveloppes -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Enveloppes}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Avertissement}" />
                                <TextBlock Text="Enveloppes" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="Budgets de dépenses (courses, carburant…) : le budget est réservé dans le prévisionnel, les dépenses saisies dans l'enveloppe en sont déduites." />
                        <DataGrid ItemsSource="{Binding Enveloppes.Elements}" SelectedItem="{Binding Enveloppes.Selection}" MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Enveloppe" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTemplateColumn Header="Catégorie" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{x:Static vm:ConfigurationViewModel.Categories}"
                                                      SelectedItem="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Budget mensuel" Width="120"
                                                    Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1">
                <!-- Comptes cumulés -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding ComptesCumul}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                                <TextBlock Text="Comptes cumulés" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="Épargne, remboursements… : additionnent chaque mois les débits des charges et opérations qui leur sont liées. Objectif : montant total à atteindre (facultatif)." />
                        <DataGrid ItemsSource="{Binding ComptesCumul.Elements}" SelectedItem="{Binding ComptesCumul.Selection}" MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Compte" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTextColumn Header="Déjà cumulé" Width="110"
                                                    Binding="{Binding MontantInitial, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                                <DataGridTextColumn Header="Objectif" Width="110"
                                                    Binding="{Binding Objectif, Converter={StaticResource Montant}}"
                                                    ElementStyle="{StaticResource CelluleMontant}"
                                                    EditingElementStyle="{StaticResource EditionMontant}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Catégories d'opérations (choisies à la main dans le mois) -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding CategoriesOperations}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                                <TextBlock Text="Catégories d'opérations" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="Agen, Maison, Voiture… : choisissez la catégorie d'une opération dans le mois (colonne « Catégorie ») ; les opérations y sont rangées par catégorie, dans l'ordre de cette liste." />
                        <DataGrid ItemsSource="{Binding CategoriesOperations.Elements}" SelectedItem="{Binding CategoriesOperations.Selection}" MinHeight="90">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTemplateColumn Header="Couleur" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource ListeCellule}"
                                                      ItemsSource="{x:Static vm:ConfigurationViewModel.Couleurs}"
                                                      SelectedItem="{Binding Couleur, UpdateSourceTrigger=PropertyChanged}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,8,0" Background="{Binding Code}" />
                                                            <TextBlock Text="{Binding Nom}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Règles de classement des relevés importés -->
                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <ContentControl DockPanel.Dock="Right" Content="{Binding Regles}" ContentTemplate="{StaticResource BoutonsListe}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                                <TextBlock Text="Règles de classement" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                   Text="À l'import d'un relevé, une dépense dont le libellé contient le mot-clé est rangée dans l'enveloppe choisie (majuscules et accents ignorés)." />
                        <DataGrid ItemsSource="{Binding Regles.Elements}" SelectedItem="{Binding Regles.Selection}" MinHeight="150" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mot-clé du libellé" Binding="{Binding MotCle}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                                <DataGridTemplateColumn Header="Enveloppe" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Style="{StaticResource ListeCellule}"
                                                      ItemsSource="{Binding DataContext.NomsEnveloppes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Enveloppe, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Modules (réglage propre à ce PC) -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                            <TextBlock Text="Modules" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <CheckBox Content="Bilan : bilan annuel, pistes d'économie, exports Excel et PDF"
                                  IsChecked="{Binding Apparence.ModuleBilan}" Margin="0,0,0,6" />
                        <CheckBox Content="Crédits : simulation et comparaison de crédits"
                                  IsChecked="{Binding Apparence.ModuleCredits}" Margin="0,0,0,6" />
                        <CheckBox Content="Prêts : prêts en cours, tableau d'amortissement, remboursement anticipé"
                                  IsChecked="{Binding Apparence.ModulePrets}" Margin="0,0,0,6" />
                        <CheckBox Content="Bourse : placements Trade Republic, positions, plus-values, cours"
                                  IsChecked="{Binding Apparence.ModuleBourse}" Margin="0,0,0,6" />
                        <CheckBox Content="Documents : documents importants, échéances, Google Drive"
                                  IsChecked="{Binding Apparence.ModuleDocuments}" Margin="0,0,0,6" />
                        <CheckBox Content="Mail : envoi de mails (Gmail ou autre messagerie), carnet d'adresses"
                                  IsChecked="{Binding Apparence.ModuleMail}" Margin="0,0,0,6" />
                        <CheckBox Content="Achats : meilleur prix avec Gemini, sites marchands, prix suivis"
                                  IsChecked="{Binding Apparence.ModuleAchats}" Margin="0,0,0,6" />
                        <CheckBox Content="Lettres : lettres types rédigées par Gemini et Groq, PDF, Word ou mail"
                                  IsChecked="{Binding Apparence.ModuleLettres}" Margin="0,0,0,6" />
                        <CheckBox Content="Assistant : questions sur votre budget à Gemini et Groq (ne modifie rien)"
                                  IsChecked="{Binding Apparence.ModuleAssistant}" Margin="0,0,0,6" />
                        <CheckBox Content="Animation du canard à l'ouverture de l'application"
                                  IsChecked="{Binding Apparence.AnimationDemarrage}" />
                        <TextBlock Style="{StaticResource Aide}" Margin="0,6,0,0"
                                   Text="Affiche ou masque les onglets dans la barre de gauche. Réglage propre à ce PC : vos données sont conservées même si un module est masqué." />
                    </StackPanel>
                </Border>

                <!-- Mises à jour de l'application -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                            <TextBlock Text="Mises à jour" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Rechercher une mise à jour" Command="{Binding MisesAJour.RechercherCommand}"
                                    Padding="12,6" />
                            <TextBlock Text="{Binding MisesAJour.VersionActuelle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="{Binding MisesAJour.Statut}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Aide}" Margin="0,6,0,0"
                                   Text="Une nouvelle version est aussi cherchée à chaque ouverture de l'application. Ses nouveautés s'affichent avant l'installation ; vos données ne sont pas modifiées." />
                    </StackPanel>
                </Border>

                <!-- Compte Google (réglage propre à ce PC) -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                            <TextBlock Text="Compte Google" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Google.Etat}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Connecter…" Command="{Binding Google.ConnecterCommand}" Padding="12,6" Margin="0,0,6,0"
                                    Visibility="{Binding Google.Connecte, Converter={StaticResource MasqueSiVrai}}" />
                            <Button Content="Reconnecter…" Command="{Binding Google.ConnecterCommand}" Padding="12,6" Margin="0,0,6,0"
                                    ToolTip="Pour accorder un accès oublié (Drive, Gmail ou contacts)"
                                    Visibility="{Binding Google.Connecte, Converter={StaticResource Visible}}" />
                            <Button Content="Déconnecter" Command="{Binding Google.DemanderDeconnexionCommand}" Padding="12,6"
                                    Visibility="{Binding Google.Connecte, Converter={StaticResource Visible}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                                   Text="Sert aux documents dans Google Drive, à l'envoi par Gmail et à l'import des contacts. Réglage propre à ce PC." />
                    </StackPanel>
                </Border>

                <!-- Intelligence artificielle (réglage propre à ce PC) -->
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                            <TextBlock Text="Intelligence artificielle" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <CheckBox Content="Utiliser les IA (décocher coupe tout envoi à Gemini et Groq)" IsChecked="{Binding IA.Actives}"
                                  Margin="0,0,0,8" />
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Saisir la clé…" Command="{Binding IA.ReglerGeminiCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Retirer" Command="{Binding IA.RetirerGeminiCommand}" Padding="10,4"
                                        Visibility="{Binding IA.GeminiConfigure, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding IA.EtatGemini}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Saisir la clé…" Command="{Binding IA.ReglerGroqCommand}" Padding="10,4" Margin="0,0,6,0" />
                                <Button Content="Retirer" Command="{Binding IA.RetirerGroqCommand}" Padding="10,4"
                                        Visibility="{Binding IA.GroqConfigure, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding IA.EtatGroq}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                                   Text="Clés gratuites de Google AI Studio (Gemini) et de GroqCloud (Groq), gardées sur ce PC et chiffrées par Windows. Seul ce que vous demandez est envoyé (le nom d'un produit pour une recherche de prix) ; l'IA ne modifie jamais vos comptes." />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Charges -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <ContentControl DockPanel.Dock="Right" Content="{Binding Charges}" ContentTemplate="{StaticResource BoutonsListe}" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                            <TextBlock Text="Charges" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                               Text="Ajoutées automatiquement à chaque nouveau mois, dans cet ordre. Pour une charge qui ne passe pas tous les mois (poubelles tous les 2 mois…), choisissez sa fréquence et un mois où elle est prélevée : elle ne sera ajoutée que les mois concernés. Pour un virement vers un autre compte (livret…), choisissez ce compte dans « Virement avec » : il y sera crédité chaque mois." />
                    <DataGrid ItemsSource="{Binding Charges.Elements}" SelectedItem="{Binding Charges.Selection}" MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Charge" Binding="{Binding Nom}" Width="*" ElementStyle="{StaticResource CelluleTexte}"
                                                    EditingElementStyle="{StaticResource EditionTexte}" />
                            <DataGridTextColumn Header="Débit" Width="80"
                                                Binding="{Binding Debit, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTextColumn Header="Crédit" Width="70"
                                                Binding="{Binding Credit, Converter={StaticResource Montant}, ConverterParameter=vide}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTemplateColumn Header="Catégorie" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{x:Static vm:ConfigurationViewModel.Categories}"
                                                  SelectedItem="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Fréquence" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{x:Static vm:ConfigurationViewModel.Frequences}"
                                                  SelectedItem="{Binding Frequence, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Prélevée en" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  Visibility="{Binding DepartModifiable, Converter={StaticResource Visible}}"
                                                  ItemsSource="{Binding DataContext.MoisDepart, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Depart, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Un mois où la charge est prélevée ; les suivants s'en déduisent avec la fréquence." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Compte cumulé" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.NomsComptesCumul, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding CompteCumul, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColonneVirement" Header="Virement avec" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.Comptes.Noms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding CompteLie, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Virement de chaque mois vers un autre compte : la charge inverse est ajoutée à sa configuration, et chaque mois créé a son virement des deux côtés." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Catégorie d'opération" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.NomsCategoriesOperations, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding CategorieOperation, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Reprise dans chaque nouveau mois (et avec « Appliquer la configuration »)." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="GestionCompte.App.Vues.VueDocuments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Etiquette" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau : recherche, filtre et ajout. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="16,12" Margin="6,6,6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding AjouterCommand}"
                            ToolTip="Ajouter un fichier (PDF, photo, scan…) au coffre">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Ajouter un document" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding ActualiserCommand}"
                            ToolTip="Relire le coffre (après une modification depuis un autre PC)">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE72C;" />
                    </Button>
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding SauvegarderCommand}" Margin="0"
                            ToolTip="Enregistrer une copie de tout le coffre dans un fichier .zip">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE74E;" Margin="0,0,8,0" />
                            <TextBlock Text="Sauvegarde" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE721;" Foreground="{DynamicResource EnteteTexte}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding Recherche, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="30"
                             ToolTip="Rechercher dans les noms et les notes" />
                    <ComboBox Style="{StaticResource ListeEntete}" ItemsSource="{Binding Filtres}" SelectedItem="{Binding Filtre}"
                              MinWidth="170" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Afficher une seule catégorie" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Message d'état ou d'erreur. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="10,2,10,4">
            <TextBlock Text="{Binding Erreur}" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Statut}" Style="{StaticResource Discret}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <!-- Colonne de gauche : rappels et liste. -->
            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Carte}"
                        Visibility="{Binding AvecRappels, Converter={StaticResource Visible}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Avertissement}" />
                            <TextBlock Text="Échéances à surveiller" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rappels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE823;" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Avertissement}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Texte}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <Grid>
                        <!-- Coffre vide. -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                                    Visibility="{Binding Vide, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE8F1;" FontSize="34" Foreground="{DynamicResource Accent2}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Aucun document pour l'instant" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Style="{StaticResource Aide}" TextAlignment="Center" MaxWidth="440"
                                       Text="Ajoutez vos papiers importants (carte d'identité, RIB, contrats, factures sous garantie…). Indiquez une échéance pour être prévenu à temps." />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Documents}" SelectedItem="{Binding Selection}"
                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding Vide, Converter={StaticResource MasqueSiVrai}}"
                                 MouseDoubleClick="OuvrirDocument">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Accent2Clair}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE8A5;" Foreground="{DynamicResource Accent2}" FontSize="15" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource Icone}" Text="&#xE72E;" FontSize="12" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Accent4}" ToolTip="Protégé par le mot de passe du coffre"
                                                           Visibility="{Binding Protege, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Discret}" FontSize="12" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Categorie, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Fichier, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource Discret}" FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding EcheanceListe}" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Colonne de droite : fiche, emplacement et protection. -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Carte}" Visibility="{Binding ASelection, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                                <TextBlock Text="Fiche du document" Style="{StaticResource TitreCarte}" />
                            </StackPanel>

                            <StackPanel DataContext="{Binding Selection}">
                                <TextBlock Style="{StaticResource Etiquette}" Text="Nom" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Nom}" Height="28" MaxLength="120" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Etiquette}" Text="Catégorie" />
                                        <ComboBox SelectedItem="{Binding Categorie}" Height="28"
                                                  ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Etiquette}" Text="Date du document" />
                                        <DatePicker SelectedDate="{Binding Date}" Height="28" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Etiquette}" Text="Échéance (expiration, renouvellement…)" />
                                        <DatePicker SelectedDate="{Binding Echeance}" Height="28" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Etiquette}" Text="Prévenir (jours avant)" />
                                        <TextBox Text="{Binding RappelJours}" Height="28" MaxLength="3" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource Etiquette}" Text="Charge liée (contrat, abonnement…)" />
                                <ComboBox SelectedItem="{Binding Charge}" Height="28"
                                          ItemsSource="{Binding DataContext.Charges, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                <TextBlock Style="{StaticResource Etiquette}" Text="Notes (numéro de contrat, contact…)" />
                                <TextBox Text="{Binding Notes}" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                                <TextBlock Style="{StaticResource Discret}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <Run Text="Fichier :" />
                                    <Run Text="{Binding Fichier, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding OuvrirCommand}" Margin="0,0,6,6" Padding="12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE8E5;" Margin="0,0,6,0" />
                                        <TextBlock Text="Ouvrir" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding EnregistrerSousCommand}" Content="Enregistrer sous…"
                                        ToolTip="Enregistrer une copie (par exemple pour l'envoyer)" />
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding RemplacerCommand}" Content="Remplacer le fichier…"
                                        ToolTip="Mettre une version plus récente (nouvelle attestation…)" />
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding ProtegerCommand}"
                                        Content="{Binding Selection.TexteProtection}"
                                        ToolTip="Chiffre le fichier avec le mot de passe du coffre (pour les documents sensibles)" />
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding EnvoyerParMailCommand}" Content="Envoyer par mail…"
                                        Visibility="{Binding EnvoiParMailPossible, Converter={StaticResource Visible}}"
                                        ToolTip="Ouvre l'onglet Mail avec ce document en pièce jointe" />
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding SupprimerCommand}" Content="Supprimer"
                                        Foreground="{DynamicResource Negatif}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Emplacement du coffre. -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                                <TextBlock Text="Emplacement des documents" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Emplacement}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding UtiliserDossierLocalCommand}" Content="Ce PC"
                                        ToolTip="Dossier Documents à côté des données de l'application" />
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding ChoisirDossierSynchroniseCommand}"
                                        Content="Dossier synchronisé…"
                                        ToolTip="Un dossier de « Mon Drive » avec l'application Google Drive pour ordinateur" />
                                <Button Style="{StaticResource BoutonAction}" Command="{Binding UtiliserGoogleDriveCommand}"
                                        Content="Google Drive (connexion directe)"
                                        ToolTip="Ranger les documents dans votre Google Drive (connexion au compte Google si besoin)" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Aide}" Margin="0,4,0,0"
                                       Text="Documents communs à tous les comptes. Avec Google Drive (dossier synchronisé ou connexion directe), vous les retrouvez sur vos autres PC. En changeant d'emplacement, l'application propose d'y copier vos documents." />
                        </StackPanel>
                    </Border>

                    <!-- Protection par mot de passe. -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                                <TextBlock Text="Protection" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Aide}" Visibility="{Binding ProtectionConfiguree, Converter={StaticResource MasqueSiVrai}}"
                                       Text="Facultatif : pour un document sensible, choisissez « Protéger ce document ». Il sera chiffré avec un mot de passe, et une clé de secours vous sera donnée en cas d'oubli." />
                            <StackPanel Visibility="{Binding ProtectionConfiguree, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE785;" Margin="0,0,8,0" Foreground="{DynamicResource Positif}"
                                               Visibility="{Binding Deverrouille, Converter={StaticResource Visible}}" />
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE72E;" Margin="0,0,8,0" Foreground="{DynamicResource Accent4}"
                                               Visibility="{Binding Deverrouille, Converter={StaticResource MasqueSiVrai}}" />
                                    <TextBlock Text="Coffre déverrouillé pour cette session"
                                               Visibility="{Binding Deverrouille, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="Coffre verrouillé : le mot de passe sera demandé"
                                               Visibility="{Binding Deverrouille, Converter={StaticResource MasqueSiVrai}}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Style="{StaticResource BoutonAction}" Command="{Binding VerrouillerCommand}" Content="Verrouiller"
                                            Visibility="{Binding Deverrouille, Converter={StaticResource Visible}}" />
                                    <Button Style="{StaticResource BoutonAction}" Command="{Binding ChangerMotDePasseCommand}" Content="Changer le mot de passe…" />
                                    <Button Style="{StaticResource BoutonAction}" Command="{Binding MotDePasseOublieCommand}" Content="Mot de passe oublié…"
                                            ToolTip="Choisir un nouveau mot de passe avec la clé de secours" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

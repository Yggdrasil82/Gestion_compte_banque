<UserControl x:Class="GestionCompte.App.Vues.VueMail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Etiquette" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,3" />
        </Style>
        <Style x:Key="BoutonAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau : compte d'envoi, nouveau mail et envoi. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="16,12" Margin="6,6,6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding NouveauCommand}" ToolTip="Effacer le mail en cours">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Nouveau" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonEnteteBlanc}" Command="{Binding EnvoyerCommand}" Padding="16,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE724;" Margin="0,0,8,0" />
                            <TextBlock Text="Envoyer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Envoyer avec :" Foreground="{DynamicResource EnteteTexte}" FontWeight="SemiBold" Margin="0,0,12,0" />
                        <RadioButton Content="Gmail" GroupName="ModeEnvoi" IsChecked="{Binding ModeGmail}"
                                     Foreground="{DynamicResource EnteteTexte}" Margin="0,0,16,0" VerticalContentAlignment="Center" />
                        <RadioButton Content="Autre messagerie (SMTP)" GroupName="ModeEnvoi" IsChecked="{Binding ModeSmtp}"
                                     Foreground="{DynamicResource EnteteTexte}" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding CompteEnvoi}" Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" FontSize="12"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="10,2,10,4">
            <TextBlock Text="{Binding Erreur}" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Statut}" Style="{StaticResource Discret}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- Rédaction du mail. -->
            <Border Style="{StaticResource Carte}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                        <TextBlock Text="Nouveau mail" Style="{StaticResource TitreCarte}" />
                    </StackPanel>

                    <WrapPanel DockPanel.Dock="Top">
                        <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding ConnecterGoogleCommand}" Margin="0,0,6,6" Padding="12,6"
                                Content="Connecter le compte Google…"
                                Visibility="{Binding ConnexionGoogleNecessaire, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource BoutonAction}" Command="{Binding ReglerSmtpCommand}" Content="Régler le serveur d'envoi…"
                                Visibility="{Binding ModeSmtp, Converter={StaticResource Visible}}" />
                    </WrapPanel>

                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Etiquette}" Text="À (plusieurs adresses séparées par ; )" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Destinataires, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                        <TextBlock Style="{StaticResource Etiquette}" Text="Copie à (facultatif)" />
                        <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Height="28" />
                        <TextBlock Style="{StaticResource Etiquette}" Text="Objet" />
                        <TextBox Text="{Binding Objet, UpdateSourceTrigger=PropertyChanged}" Height="28" MaxLength="200" />
                    </StackPanel>

                    <!-- Pièces jointes. -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TaillePieces}" Style="{StaticResource Discret}" FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Pièces jointes" Style="{StaticResource Discret}" FontSize="12" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PiecesJointes}" Margin="0,6,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Accent1Clair}" CornerRadius="8" Padding="10,4,4,4" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE723;" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Nom}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="11" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <Button Padding="6,2" Margin="6,0,0,0" ToolTip="Retirer cette pièce jointe"
                                                    Command="{Binding DataContext.RetirerPieceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Style="{StaticResource Icone}" Text="&#xE711;" FontSize="10" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel>
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding JoindreDocumentsCommand}"
                                    Visibility="{Binding DocumentsDisponibles, Converter={StaticResource Visible}}"
                                    ToolTip="Choisir des documents dans l'onglet Documents">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE8F1;" Margin="0,0,6,0" />
                                    <TextBlock Text="Documents du coffre…" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding JoindreBilanCommand}"
                                    Visibility="{Binding BilanDisponible, Converter={StaticResource Visible}}"
                                    ToolTip="Joindre le bilan affiché dans l'onglet Bilan, en PDF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE9D2;" Margin="0,0,6,0" />
                                    <TextBlock Text="Bilan en PDF" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding JoindreFichierCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icone}" Text="&#xE723;" Margin="0,0,6,0" />
                                    <TextBlock Text="Autre fichier…" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Etiquette}" Text="Message" />
                        <TextBox Text="{Binding Corps, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="120" Padding="6" />
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- Carnet d'adresses et historique. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Discret}" FontSize="12" VerticalAlignment="Center"
                                       Text="{Binding NombreContacts, StringFormat='{}{0} contacts'}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                                <TextBlock Text="Carnet d'adresses" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBox DockPanel.Dock="Top" Text="{Binding RechercheContact, UpdateSourceTrigger=PropertyChanged}" Height="28"
                                 ToolTip="Rechercher un nom, une adresse ou une note" Margin="0,0,0,6" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding EcrireAuContactCommand}" Content="Écrire"
                                    ToolTip="Ajouter aux destinataires (ou double-clic)" />
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding NouveauContactCommand}" Content="Ajouter…" />
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding ModifierContactCommand}" Content="Modifier…" />
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding SupprimerContactCommand}" Content="Supprimer" />
                            <Button Style="{StaticResource BoutonAction}" Command="{Binding ImporterContactsGoogleCommand}"
                                    Content="Importer de Google" ToolTip="Ajouter au carnet vos contacts Google" />
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding ContactSelectionne}"
                                 Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="EcrireAuContact">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Text="{Binding Affichage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource Discret}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Carte}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Command="{Binding ViderHistoriqueCommand}" Content="Vider" Padding="8,3"
                                    Visibility="{Binding AvecHistorique, Converter={StaticResource Visible}}" />
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                                <TextBlock Text="Mails envoyés" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}" Text="Aucun mail envoyé pour l'instant."
                                   Visibility="{Binding AvecHistorique, Converter={StaticResource MasqueSiVrai}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Historique}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,10">
                                            <Button DockPanel.Dock="Right" Content="Reprendre" Padding="8,3" VerticalAlignment="Top"
                                                    ToolTip="Reprendre les destinataires et l'objet"
                                                    Command="{Binding DataContext.ReprendreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <StackPanel>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Date, Mode=OneWay}" Foreground="{DynamicResource TexteDiscret}" />
                                                    <Run Text="{Binding Objet, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Destinataires}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="Detail" Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Reussi}" Value="False">
                                                <Setter TargetName="Detail" Property="Foreground" Value="{DynamicResource Negatif}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="GestionCompte.App.Vues.VueBourse"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tuile" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="LibelleTuile" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ValeurTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Etape" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- Titres rangés par enveloppe : compte-titres puis PEA. -->
        <CollectionViewSource x:Key="PositionsParEnveloppe" Source="{Binding Positions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Enveloppe" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="16,12" Margin="6,6,6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding ImporterCommand}"
                            ToolTip="Importer l'export des transactions de Trade Republic (.csv) ; les opérations déjà importées sont ignorées">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE8B5;" Margin="0,0,8,0" />
                            <TextBlock Text="Importer" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding ActualiserCoursCommand}"
                            ToolTip="Chercher le dernier cours de chaque titre sur Yahoo Finance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE72C;" Margin="0,0,8,0" />
                            <TextBlock Text="Actualiser les cours" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding ViderCommand}" Margin="0"
                            ToolTip="Effacer les opérations importées et les cours de ce compte">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Bourse" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource EnteteTexte}" />
                    <TextBlock Text="Vos placements Trade Republic (PEA et compte-titres) : positions, plus-values et dernier cours connu. Tout reste sur votre PC."
                               Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Statut}" Margin="12,2,12,4" FontWeight="SemiBold"
                   Foreground="{DynamicResource Accent1}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid>
            <!-- Aucun placement : comment faire l'export -->
            <Border Style="{StaticResource Carte}" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left"
                    Visibility="{Binding Vide, Converter={StaticResource Visible}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                        <TextBlock Text="Importer vos placements" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Etape}" Text="1. Dans l'application Trade Republic du téléphone : touchez votre profil, puis « Relevés »." />
                    <TextBlock Style="{StaticResource Etape}" Text="2. Choisissez « Export des transactions », la période « Depuis le début », puis « Créer » : un fichier .csv est créé." />
                    <TextBlock Style="{StaticResource Etape}" Text="3. Envoyez-vous ce fichier (mail, Google Drive…) et enregistrez-le sur ce PC." />
                    <TextBlock Style="{StaticResource Etape}" Text="4. Cliquez sur « Importer » et choisissez le fichier. Refaites un export de temps en temps : seules les nouvelles opérations sont ajoutées." />
                    <Button Style="{StaticResource BoutonPrincipal}" Command="{Binding ImporterCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE8B5;" Margin="0,0,8,0" />
                            <TextBlock Text="Importer l'export de Trade Republic" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource Aide}" Margin="0,10,0,0"
                               Text="Le fichier contient le nom des titres, les quantités et les montants. Les cours sont ensuite cherchés sur Yahoo Finance (gratuit, sans compte) ; vous pouvez aussi les saisir à la main." />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding Vide, Converter={StaticResource MasqueSiVrai}}">
                <StackPanel>
                    <!-- Chiffres clés : le réalisé d'abord (le plus important), puis l'impôt, la valeur et le latent. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent3}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Réalisé, revenus et frais" />
                                <Grid ToolTip="{Binding DetailRealise}" Cursor="Help" Margin="0,2,0,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Bilan.PlusValuesRealisees, Converter={StaticResource Euros}}" />
                                    <TextBlock Text="Plus-values des ventes" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding TexteHorsFraisAchat}" TextAlignment="Right" TextWrapping="Wrap"
                                           ToolTip="{Binding DetailRealise}" Cursor="Help"
                                           Visibility="{Binding AfficherHorsFraisAchat, Converter={StaticResource Visible}}" />
                                <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Bilan.Dividendes, Converter={StaticResource Euros}}" />
                                    <TextBlock Text="Dividendes et intérêts (bruts)" TextWrapping="Wrap" />
                                </Grid>
                                <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TexteTaxesSurRevenus}" />
                                    <TextBlock Text="Taxes retenues sur les revenus" Margin="0,0,12,0" TextWrapping="Wrap" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource Bordure}" Margin="0,5" />
                                <Grid ToolTip="{Binding DetailGainNet}" Cursor="Help">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding TexteGainRealiseNet}" FontSize="16" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GainRealisePositif}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Gain réalisé net" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Style="{StaticResource LibelleTuile}" Margin="0,2,0,0"
                                           Text="{Binding Bilan.FraisEtTaxes, Converter={StaticResource Euros}, StringFormat='Frais et taxes payés au total {0} (déjà déduits)'}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent4}" ToolTip="{Binding DetailImpot}" Cursor="Help">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Gain net et impôt" />
                                <TextBlock Text="{Binding TexteNetApresImpot}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ValeurTuile}">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent4}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetApresImpotPositif}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Net après impôt" Margin="0,0,0,4" />
                                <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TexteGainRealiseNet}" />
                                    <TextBlock Text="Gain net" TextWrapping="Wrap" />
                                </Grid>
                                <Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TexteFlatTax}" />
                                    <TextBlock Text="{Binding LibelleFlatTax}" TextWrapping="Wrap" Margin="0,0,8,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource LibelleTuile}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="PEA : pas d'impôt tant qu'il n'y a pas de retrait." />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent1}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Valeur du portefeuille" />
                                <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent1}"
                                           Text="{Binding Bilan.ValeurTotale, Converter={StaticResource Euros}}" />
                                <TextBlock Style="{StaticResource LibelleTuile}"><Run Text="Titres " /><Run Text="{Binding Bilan.ValeurTitres, Mode=OneWay, Converter={StaticResource Euros}}" /><Run Text=", espèces " /><Run Text="{Binding Bilan.Especes, Mode=OneWay, Converter={StaticResource Euros}}" /></TextBlock>
                                <TextBlock Style="{StaticResource LibelleTuile}" ToolTip="{Binding DetailVerse}" Cursor="Help"
                                           Text="{Binding Bilan.VerseNet, Converter={StaticResource Euros}, StringFormat='Argent versé {0}'}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent2}" ToolTip="{Binding DetailPlusValue}" Cursor="Help">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Plus-value latente" />
                                <TextBlock Text="{Binding TexteMontantPlusValue}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource ValeurTuile}">
                                            <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlusValuePositive}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding DetailLatent}" />
                                <Grid ToolTip="{Binding DetailVerse}" Cursor="Help" Margin="0,6,0,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{Binding TexteGain}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Accent4}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GainPositif}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Prévision de gain" Margin="0,0,8,0" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Aide à la décision : constats chiffrés sur tout le portefeuille. -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding AnalyserCommand}" VerticalAlignment="Center"
                                        ToolTip="Ouvre l'Assistant et lui envoie un résumé du portefeuille (sans ISIN ni numéro de compte) avec ces indicateurs">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE8BD;" Margin="0,0,8,0" />
                                        <TextBlock Text="Analyser avec l'Assistant" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                                    <TextBlock Text="Aide à la décision" Style="{StaticResource TitreCarte}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Aide}"
                                       Text="Constats calculés sur tout le portefeuille à partir de vos opérations : ce ne sont pas des conseils d'achat ou de vente." />
                            <ItemsControl ItemsSource="{Binding Indicateurs}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Border Width="10" Height="10" CornerRadius="5" Margin="2,5,10,0" VerticalAlignment="Top" DockPanel.Dock="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Accent1}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Niveau}" Value="Bon">
                                                                <Setter Property="Background" Value="{DynamicResource Positif}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Niveau}" Value="Attention">
                                                                <Setter Property="Background" Value="{DynamicResource Avertissement}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Titre, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" : " /><Run Text="{Binding Texte, Mode=OneWay}" /></TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Positions -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            Visibility="{Binding AEnveloppes, Converter={StaticResource Visible}}">
                                    <TextBlock Text="Afficher" Style="{StaticResource Discret}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding Filtres}" SelectedIndex="{Binding Filtre}" Width="140" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                                    <TextBlock Text="Mes titres" Style="{StaticResource TitreCarte}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Aide}"
                                       Text="Le cours et le symbole Yahoo se corrigent dans le tableau (double-clic). Survolez un chiffre pour voir son calcul." />
                            <DataGrid ItemsSource="{Binding Source={StaticResource PositionsParEnveloppe}}" Margin="0,6,0,0" RowHeight="44">
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,8,0,2" Padding="10,4" CornerRadius="6" Background="{DynamicResource LigneAlternee}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Margin="0,0,8,0"
                                                                   Text="{Binding Items[0].TotalEnveloppe, Converter={StaticResource Euros}}" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=' · {0} titre(s)'}" Style="{StaticResource Discret}"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Titre" Width="*" MinWidth="200" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,2">
                                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nom}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TexteDiscret}">
                                                        <Run Text="{Binding Isin, Mode=OneWay}" />
                                                        <Run Text="·" />
                                                        <Run Text="{Binding Enveloppe, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Quantité" Width="80" IsReadOnly="True" Binding="{Binding TexteQuantite, Mode=OneWay}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Width="90" IsReadOnly="True" Binding="{Binding Pru, Mode=OneWay, Converter={StaticResource Montant}}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="PRU" ToolTip="Prix de revient unitaire : prix moyen pondéré des achats, frais et taxes compris" />
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="ToolTip" Value="{Binding InfoPrixRevient}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Cours" Width="90" Binding="{Binding Cours, Converter={StaticResource Montant}}"
                                                        EditingElementStyle="{StaticResource EditionMontant}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="ToolTip" Value="{Binding InfoCours}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Width="95" Binding="{Binding SymboleSaisi}"
                                                        ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="Yahoo" ToolTip="Code du titre sur Yahoo Finance (ex. CW8.PA), trouvé à partir de l'ISIN ; à corriger si le cours est faux" />
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Valeur" Width="100" IsReadOnly="True" Binding="{Binding Valeur, Mode=OneWay, Converter={StaticResource Montant}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Plus-value" Width="150" IsReadOnly="True" Binding="{Binding TextePlusValue, Mode=OneWay}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perte}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Part" Width="130" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="6,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding TextePart}" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Grid Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Border Background="{DynamicResource Bordure}" CornerRadius="3" />
                                                        <Border Background="{DynamicResource Accent1}" CornerRadius="3" HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource Proportion}">
                                                                    <Binding Path="PartBarre" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0" Foreground="{DynamicResource Avertissement}"
                                       Text="{Binding TexteSansCours}" />
                        </StackPanel>
                    </Border>

                    <!-- Titres vendus : bilan de chaque titre entièrement vendu ; un clic montre son historique. -->
                    <Border Style="{StaticResource Carte}" Visibility="{Binding AvecTitresVendus, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                                <TextBlock Text="Titres vendus" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Aide}"
                                       Text="Acheté : frais et taxes compris. Dividendes : nets des taxes retenues. Vendu : net des frais. Cliquez sur une ligne pour voir ses opérations." />
                            <DataGrid ItemsSource="{Binding TitresVendus}" SelectedItem="{Binding SelectionVendus}" IsReadOnly="True" Margin="0,6,0,0" RowHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Titre" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,2">
                                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nom}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TexteDiscret}" Text="{Binding Enveloppe}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Acheté" Width="100" Binding="{Binding Achete, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Dividendes" Width="100" Binding="{Binding Dividendes, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Vendu" Width="100" Binding="{Binding Vendu, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Gain des ventes" Width="150" Binding="{Binding TexteGainVentes, Mode=OneWay}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perte}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Bilan des titres détenus : achats, dividendes et ventes partielles sur une ligne, et le secteur. -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                                <TextBlock Text="Bilan par titre" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Aide}"
                                       Text="Titres encore détenus : tout ce qui a été acheté, reçu en dividendes et vendu. Le secteur sert à la répartition en bas de page. Cliquez sur une ligne pour voir ses opérations." />
                            <DataGrid ItemsSource="{Binding TitresDetenus}" SelectedItem="{Binding SelectionDetenus}" IsReadOnly="True" Margin="0,6,0,0" RowHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Titre" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="6,2">
                                                    <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nom}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TexteDiscret}" Text="{Binding Enveloppe}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Secteur" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource ListeSaisie}" Margin="2,0" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.Secteurs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Text="{Binding Secteur, UpdateSourceTrigger=LostFocus}"
                                                          ToolTip="Choisissez un secteur ou tapez-en un nouveau" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Acheté" Width="100" Binding="{Binding Achete, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Dividendes" Width="100" Binding="{Binding Dividendes, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Vendu" Width="100" Binding="{Binding Vendu, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Gain des ventes" Width="150" Binding="{Binding TexteGainVentes, Mode=OneWay}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perte}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Historique -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ToutLHistoriqueCommand}" VerticalAlignment="Center"
                                        Visibility="{Binding HistoriqueFiltre, Converter={StaticResource Visible}}" Content="Tout afficher" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                                    <TextBlock Text="{Binding TitreHistorique}" Style="{StaticResource TitreCarte}" />
                                </StackPanel>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding Historique}" IsReadOnly="True" MaxHeight="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Width="90" Binding="{Binding Date, Mode=OneWay, StringFormat=dd/MM/yyyy}"
                                                        ElementStyle="{StaticResource CelluleTexte}" />
                                    <DataGridTextColumn Header="Compte" Width="70" Binding="{Binding Enveloppe, Mode=OneWay}" ElementStyle="{StaticResource CelluleTexte}" />
                                    <DataGridTextColumn Header="Type" Width="90" Binding="{Binding Type, Mode=OneWay}" ElementStyle="{StaticResource CelluleTexte}" />
                                    <DataGridTextColumn Header="Libellé" Width="*" Binding="{Binding Libelle, Mode=OneWay}" ElementStyle="{StaticResource CelluleTexte}" />
                                    <DataGridTextColumn Header="Montant" Width="110" Binding="{Binding Montant, Mode=OneWay, Converter={StaticResource Montant}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Negatif}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Texte}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                                       Text="Montant : effet sur les espèces du compte Trade Republic, frais et taxes compris (négatif pour un achat)." />
                        </StackPanel>
                    </Border>

                    <!-- Idées d'investissement : titres à surveiller, carte repliable. -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Command="{Binding AjouterIdeeCommand}" ToolTip="Ajouter une idée d'investissement" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" Margin="0,0,6,0" />
                                            <TextBlock Text="Ajouter" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding BasculerIdeesCommand}" Padding="8,4" ToolTip="Replier ou déplier la carte">
                                        <Grid>
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE70D;"
                                                       Visibility="{Binding IdeesRepliees, Converter={StaticResource Visible}}" />
                                            <TextBlock Style="{StaticResource Icone}" Text="&#xE70E;"
                                                       Visibility="{Binding IdeesRepliees, Converter={StaticResource MasqueSiVrai}}" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                                    <TextBlock Text="Idées d'investissement" Style="{StaticResource TitreCarte}" />
                                    <TextBlock Style="{StaticResource Discret}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding Idees.Count, StringFormat='({0})'}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Visibility="{Binding IdeesRepliees, Converter={StaticResource MasqueSiVrai}}">
                                <TextBlock Style="{StaticResource Aide}"
                                           Text="Titres à surveiller avant de les acheter. Le cours se met à jour avec « Actualiser les cours » ; indiquez l'ISIN ou le code Yahoo s'il n'est pas trouvé avec le nom." />
                                <TextBlock Style="{StaticResource Discret}" Margin="0,8,0,0" Text="Aucune idée pour l'instant : cliquez sur « Ajouter »."
                                           Visibility="{Binding AucuneIdee, Converter={StaticResource Visible}}" />
                                <DataGrid ItemsSource="{Binding Idees}" Margin="0,6,0,0" RowHeight="36"
                                          Visibility="{Binding AucuneIdee, Converter={StaticResource MasqueSiVrai}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nom" Width="190" Binding="{Binding Nom}"
                                                            ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}" />
                                        <DataGridTemplateColumn Header="Secteur" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{StaticResource ListeSaisie}" Margin="2,0" VerticalAlignment="Center"
                                                              ItemsSource="{Binding DataContext.Secteurs, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Text="{Binding Secteur, UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Width="130" Binding="{Binding Recherche}"
                                                            ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="ISIN / Yahoo" ToolTip="ISIN (ex. FR0000120073) ou code Yahoo (ex. AI.PA) ; vide : le cours est cherché avec le nom" />
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Cours" Width="90" IsReadOnly="True" Binding="{Binding Cours, Mode=OneWay, Converter={StaticResource Montant}}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                    <Setter Property="ToolTip" Value="{Binding InfoCours}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Note" Width="*" Binding="{Binding Note}"
                                                            ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}" />
                                        <DataGridTemplateColumn Width="44" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.RetirerIdeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="6,2" ToolTip="Retirer cette idée">
                                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE738;" FontSize="10" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Répartition par secteur : en bas, information secondaire. -->
                    <Border Style="{StaticResource Carte}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                                <TextBlock Text="Répartition par secteur" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Aide}" Text="Valeur des titres détenus par secteur. Le secteur se choisit dans « Bilan par titre »." />
                            <ItemsControl ItemsSource="{Binding RepartitionSecteurs}" Margin="0,6,0,0" Width="640" HorizontalAlignment="Left">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Secteur}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Grid Grid.Column="1" Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border Background="{DynamicResource Bordure}" CornerRadius="3" />
                                                <Border Background="{DynamicResource Accent4}" CornerRadius="3" HorizontalAlignment="Left">
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource Proportion}">
                                                            <Binding Path="PartBarre" />
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding TextePart}" TextAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Valeur, Converter={StaticResource Euros}}" TextAlignment="Right"
                                                       Style="{StaticResource Discret}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0" Foreground="{DynamicResource Avertissement}" Text="{Binding AlerteSecteur}"
                                       Visibility="{Binding AvecAlerteSecteur, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

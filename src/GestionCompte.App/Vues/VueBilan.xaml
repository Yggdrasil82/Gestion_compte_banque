<UserControl x:Class="GestionCompte.App.Vues.VueBilan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:GestionCompte.App">
    <UserControl.Resources>
        <Style x:Key="Tuile" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="LibelleTuile" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ValeurTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="DetailTuile" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="PuceLegende" TargetType="Border">
            <Setter Property="Width" Value="11" />
            <Setter Property="Height" Value="11" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau : choix de la période et exports. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="16,12" Margin="6,6,6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding ExporterExcelCommand}" ToolTip="Exporter le bilan dans un classeur Excel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE896;" Margin="0,0,8,0" />
                            <TextBlock Text="Excel" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding ExporterPdfCommand}" ToolTip="Exporter le bilan en PDF (à imprimer ou envoyer)"
                            Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE749;" Margin="0,0,8,0" />
                            <TextBlock Text="PDF" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource ListeEntete}" ItemsSource="{Binding Choix}" SelectedItem="{Binding Selection}"
                              DisplayMemberPath="Libelle" ToolTip="Choisir l'année ou les 12 derniers mois" MinWidth="290" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Etendue}" Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" FontSize="12"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MessageExport}" Style="{StaticResource Discret}" Margin="10,2,10,4"
                   TextTrimming="CharacterEllipsis" />

        <Grid>
            <!-- Aucun mois sur la période choisie. -->
            <Border Style="{StaticResource Carte}" VerticalAlignment="Top" Padding="24"
                    Visibility="{Binding Vide, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE9D2;" FontSize="34" Foreground="{DynamicResource Accent1}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Pas encore de mois sur cette période" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Style="{StaticResource Aide}" TextAlignment="Center" MaxWidth="460"
                               Text="Le bilan se calcule à partir des mois créés dans l'onglet Mois. Choisissez une autre année dans la liste en haut." />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding AvecMois, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="460" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Chiffres clés -->
                    <UniformGrid Grid.Row="0" Grid.ColumnSpan="2" Columns="4">
                        <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Positif}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Revenus" />
                                <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Positif}"
                                           Text="{Binding Resultat.Revenus, Converter={StaticResource Euros}}" />
                                <TextBlock Style="{StaticResource DetailTuile}" Text="{Binding ComparaisonRevenus}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent3}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Dépenses (hors épargne)" />
                                <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent3}"
                                           Text="{Binding Resultat.Depenses, Converter={StaticResource Euros}}" />
                                <TextBlock Style="{StaticResource DetailTuile}" Text="{Binding ComparaisonDepenses}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent4}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}">
                                    <Run Text="Épargne" />
                                    <Run Text="{Binding TauxEpargne, Mode=OneWay, StringFormat='· {0}'}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent4}"
                                           Text="{Binding Resultat.Epargne, Converter={StaticResource Euros}}" />
                                <TextBlock Style="{StaticResource DetailTuile}" Text="{Binding ComparaisonEpargne}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent1}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LibelleTuile}" Text="Solde en fin de période" />
                                <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent1}"
                                           Text="{Binding Resultat.SoldeFin, Converter={StaticResource Euros}}" />
                                <TextBlock Text="{Binding Variation}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DetailTuile}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VariationNegative}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Graphique mois par mois -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Carte}" Height="330">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                                    <Border Style="{StaticResource PuceLegende}" Background="{DynamicResource Positif}" />
                                    <TextBlock Text="revenus" Style="{StaticResource Discret}" Margin="6,0,14,0" />
                                    <Border Style="{StaticResource PuceLegende}" Background="{DynamicResource Accent3}" />
                                    <TextBlock Text="dépenses" Style="{StaticResource Discret}" Margin="6,0,14,0" />
                                    <Border Style="{StaticResource PuceLegende}" Background="{DynamicResource Accent4}" />
                                    <TextBlock Text="épargne" Style="{StaticResource Discret}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                                    <TextBlock Text="Mois par mois" Style="{StaticResource TitreCarte}" />
                                </StackPanel>
                            </DockPanel>
                            <app:GraphiqueBilan Mois="{Binding Mois}" Margin="0,6,0,0"
                                                CouleurRevenus="{DynamicResource Positif}" CouleurDepenses="{DynamicResource Accent3}"
                                                CouleurEpargne="{DynamicResource Accent4}"
                                                CouleurGrille="{DynamicResource Bordure}" CouleurTexte="{DynamicResource TexteDiscret}" />
                        </DockPanel>
                    </Border>

                    <!-- Pistes d'économie -->
                    <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Carte}" VerticalAlignment="Top">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Positif}" />
                                <TextBlock Text="Pistes d'économie" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GainPossible}" FontWeight="SemiBold" Foreground="{DynamicResource Positif}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Pistes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Accent2Clair}" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Foreground="{DynamicResource Positif}" Margin="10,0,0,0"
                                                               Text="{Binding GainAnnuel, Converter={StaticResource Euros}, StringFormat='{}{0} / an'}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding GainAnnuel}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Titre}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Discret}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Aide}" FontStyle="Italic" Text="Rien de particulier à signaler sur cette période."
                                       Visibility="{Binding Pistes.Count, Converter={StaticResource VisibleSiEgal}, ConverterParameter=0}" />
                        </StackPanel>
                    </Border>

                    <!-- Postes de dépenses -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Carte}" VerticalAlignment="Top">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                                <TextBlock Text="Postes de dépenses" Style="{StaticResource TitreCarte}" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                                       Text="Du plus gros au plus petit. « Par mois » : total divisé par le nombre de mois ; l'évolution compare aux mêmes mois un an plus tôt. Les enveloppes comptent pour leur budget, ou leur dépense réelle si elle l'a dépassé." />
                            <DataGrid ItemsSource="{Binding Postes}" IsReadOnly="True" VerticalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Poste" Binding="{Binding Nom, Mode=OneWay}" Width="*" MinWidth="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleTexte}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleTexte}">
                                                <Setter Property="Foreground" Value="{DynamicResource TexteDiscret}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Total" Width="100" Binding="{Binding Total, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Par mois" Width="90" Binding="{Binding Moyenne, Mode=OneWay, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTemplateColumn Header="Part des revenus" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="6,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Part}" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                                                    <Grid Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Border Background="{DynamicResource Bordure}" CornerRadius="3" />
                                                        <Border Background="{DynamicResource Accent3}" CornerRadius="3" HorizontalAlignment="Left">
                                                            <Border.Width>
                                                                <MultiBinding Converter="{StaticResource Proportion}">
                                                                    <Binding Path="PartBarre" />
                                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                </MultiBinding>
                                                            </Border.Width>
                                                        </Border>
                                                    </Grid>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Un an avant" Width="95" Binding="{Binding Avant, Mode=OneWay, Converter={StaticResource Montant}}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource TexteDiscret}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Évolution" Width="85" Binding="{Binding Evolution, Mode=OneWay}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource TexteDiscret}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EvolutionDefavorable}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EvolutionFavorable}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>

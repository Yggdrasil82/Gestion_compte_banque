<UserControl x:Class="GestionCompte.App.Vues.VueMois"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Revenus et enveloppes, côte à côte. -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="+" ToolTip="Ajouter un revenu (prime…)" Command="{Binding Revenus.AjouterCommand}" />
                            <Button Content="−" ToolTip="Supprimer le revenu sélectionné" Command="{Binding Revenus.SupprimerCommand}" Margin="0" />
                        </StackPanel>
                        <TextBlock Text="Revenus du mois" Style="{StaticResource TitreCarte}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Revenus.Elements}" SelectedItem="{Binding Revenus.Selection}" Height="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Revenu" Binding="{Binding Nom}" Width="*"
                                                ElementStyle="{StaticResource CelluleTexte}" />
                            <DataGridTextColumn Header="Montant" Width="110"
                                                Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Carte}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Enveloppes" Style="{StaticResource TitreCarte}" />
                    <DataGrid ItemsSource="{Binding Enveloppes}" Height="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Enveloppe" Binding="{Binding Nom, Mode=OneWay}" Width="*" MinWidth="85" IsReadOnly="True"
                                                ElementStyle="{StaticResource CelluleTexte}" />
                            <DataGridTextColumn Header="Budget" Width="72"
                                                Binding="{Binding Budget, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTextColumn Header="Dépensé" Width="72" IsReadOnly="True"
                                                Binding="{Binding Depense, Mode=OneWay, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}" />
                            <DataGridTextColumn Header="Reste" Width="72" IsReadOnly="True"
                                                Binding="{Binding Reste, Mode=OneWay, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}" />
                            <DataGridTemplateColumn Header="Utilisation" Width="*" MinWidth="60" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Progression, Mode=OneWay}" Maximum="100" Height="12" Margin="6,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Foreground" Value="{StaticResource Positif}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Depassee}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Negatif}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Opérations du mois. -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Carte}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Ajouter une opération" Command="{Binding Operations.AjouterCommand}"
                                Style="{StaticResource BoutonPrincipal}" />
                        <Button Content="Supprimer" Command="{Binding Operations.SupprimerCommand}" />
                        <Button Content="▲" ToolTip="Monter" Command="{Binding Operations.MonterCommand}" />
                        <Button Content="▼" ToolTip="Descendre" Command="{Binding Operations.DescendreCommand}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="Opérations" Style="{StaticResource TitreCarte}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                           Text="Cochez « Pointé » quand l'opération apparaît sur le relevé. Choisissez une enveloppe pour les dépenses de courses, carburant… : elles sont déduites de son budget." />

                <DataGrid ItemsSource="{Binding Operations.Elements}" SelectedItem="{Binding Operations.Selection}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Pointé" Width="68">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Pointee, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*" MinWidth="160"
                                            ElementStyle="{StaticResource CelluleTexte}" />
                        <DataGridTemplateColumn Header="Enveloppe" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.NomsEnveloppes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Enveloppe, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Compte cumulé" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.NomsComptesCumul, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding CompteCumul, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Débit" Width="100"
                                            Binding="{Binding Debit, Converter={StaticResource Montant}}"
                                            ElementStyle="{StaticResource CelluleMontant}"
                                            EditingElementStyle="{StaticResource EditionMontant}" />
                        <DataGridTextColumn Header="Crédit" Width="100"
                                            Binding="{Binding Credit, Converter={StaticResource Montant}}"
                                            ElementStyle="{StaticResource CelluleMontant}"
                                            EditingElementStyle="{StaticResource EditionMontant}" />
                        <DataGridTextColumn Header="Solde" Width="110" IsReadOnly="True"
                                            Binding="{Binding Solde, Mode=OneWay, Converter={StaticResource Montant}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoldeNegatif}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Negatif}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Résumé à droite. -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Résumé du mois" Style="{StaticResource TitreCarte}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ancien solde" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AncienSolde, Converter={StaticResource Euros}}" />
                            <TextBlock Grid.Row="1" Text="+ Revenus" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalRevenus, Converter={StaticResource Euros}}" />
                            <TextBlock Grid.Row="2" Text="= Solde de départ" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoldeDepart, Converter={StaticResource Euros}}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="− Réservé pour les enveloppes" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalReserveEnveloppes, Converter={StaticResource Euros}}" />
                            <TextBlock Grid.Row="4" Text="− Débits" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalDebits, Converter={StaticResource Euros}}" />
                            <TextBlock Grid.Row="5" Text="+ Crédits" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalCredits, Converter={StaticResource Euros}}" />
                        </Grid>

                        <Border Background="{StaticResource AccentClair}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Solde prévisionnel de fin de mois" Foreground="{StaticResource TexteDiscret}" />
                                <TextBlock Text="{Binding SoldeFin, Converter={StaticResource Euros}}" FontSize="28" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Positif}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SoldeFinNegatif}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Negatif}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Pointage" Style="{StaticResource TitreCarte}" />
                        <TextBlock Text="{Binding ResumePointage}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <TextBlock Text="Comptes cumulés" Style="{StaticResource TitreCarte}" />
                        <TextBlock Style="{StaticResource Aide}" Text="Total depuis le début, ce mois inclus." />
                        <ItemsControl ItemsSource="{Binding ComptesCumul}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Euros}}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Nom}" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Progression, Mode=OneWay}" Maximum="100" Height="8" Margin="0,4,0,2"
                                                     Foreground="{StaticResource Accent}"
                                                     Visibility="{Binding AObjectif, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TexteDiscret}"
                                                   Visibility="{Binding AObjectif, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="GestionCompte.App.Vues.VueMois"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Tuile de chiffre clé, avec un liseré de couleur à gauche. -->
        <Style x:Key="Tuile" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="IconeTuile" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="LibelleTuile" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ValeurTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chiffres clés -->
        <UniformGrid Grid.Row="0" Grid.ColumnSpan="2" Columns="4">
            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent1}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent1Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE8C7;" FontSize="18" Foreground="{DynamicResource Accent1}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="Solde fin de mois" />
                        <TextBlock Text="{Binding SoldeFin, Converter={StaticResource Euros}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValeurTuile}">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent1}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoldeFinNegatif}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent2}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent2Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="18" Foreground="{DynamicResource Accent2}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="Revenus" />
                        <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent2}"
                                   Text="{Binding TotalRevenus, Converter={StaticResource Euros}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent3}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent3Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE738;" FontSize="18" Foreground="{DynamicResource Accent3}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="Dépenses prévues" />
                        <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent3}"
                                   Text="{Binding DepensesPrevues, Converter={StaticResource Euros}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent4}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent4Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE734;" FontSize="18" Foreground="{DynamicResource Accent4}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}"
                                   Text="{Binding CompteCumulPrincipal.Nom, StringFormat='{}{0} cumulée', FallbackValue=Épargne}" />
                        <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent4}"
                                   Text="{Binding CompteCumulPrincipal.Total, Converter={StaticResource Euros}, FallbackValue=—}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Revenus et enveloppes -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Button ToolTip="Ajouter un revenu (prime…)" Command="{Binding Revenus.AjouterCommand}" Padding="0" Width="28" Height="28">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" />
                            </Button>
                            <Button ToolTip="Supprimer le revenu sélectionné" Command="{Binding Revenus.SupprimerCommand}"
                                    Padding="0" Width="28" Height="28" Margin="0">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE738;" FontSize="11" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                            <TextBlock Text="Revenus du mois" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Revenus.Elements}" SelectedItem="{Binding Revenus.Selection}" Height="150">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Reçu" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Recu, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Revenu vu sur le relevé bancaire" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Revenu" Binding="{Binding Nom}" Width="*"
                                                ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}" />
                            <DataGridTextColumn Header="Montant" Width="100"
                                                Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}"
                                                EditingElementStyle="{StaticResource EditionMontant}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Carte}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent3}" />
                        <TextBlock Text="Enveloppes" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,10,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Budget" Style="{StaticResource Discret}" FontSize="12" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        <TextBlock Grid.Column="2" Text="Dépensé" Style="{StaticResource Discret}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Reste" Style="{StaticResource Discret}" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="150">
                        <ItemsControl ItemsSource="{Binding Enveloppes}" Margin="0,0,10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Budget, Converter={StaticResource Montant}}"
                                                     TextAlignment="Right" Width="80" HorizontalAlignment="Right"
                                                     ToolTip="Budget de ce mois (modifiable)" />
                                            <TextBlock Grid.Column="2" Text="{Binding Depense, Converter={StaticResource Montant}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Reste, Converter={StaticResource Montant}}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" />
                                        </Grid>
                                        <ProgressBar Value="{Binding Progression, Mode=OneWay}" Maximum="100" Margin="0,6,0,0">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent2}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PresqueAtteint}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Avertissement}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Depassee}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Opérations du mois -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Carte}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                        <Button Command="{Binding Operations.AjouterCommand}" Style="{StaticResource BoutonPrincipal}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="Ajouter une opération" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Operations.SupprimerCommand}" ToolTip="Supprimer l'opération sélectionnée"
                                Padding="0" Width="32" Height="30">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" />
                        </Button>
                        <Button Command="{Binding Operations.MonterCommand}" ToolTip="Monter" Padding="0" Width="32" Height="30">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE70E;" />
                        </Button>
                        <Button Command="{Binding Operations.DescendreCommand}" ToolTip="Descendre" Padding="0" Width="32" Height="30" Margin="0">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE70D;" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                        <TextBlock Text="Opérations" Style="{StaticResource TitreCarte}" />
                        <TextBlock Text="{Binding ResumePointage}" Style="{StaticResource Discret}" Margin="14,0,0,8" VerticalAlignment="Center" />
                        <CheckBox Content="Ranger par catégorie" IsChecked="{Binding RangerParCategorie}" Margin="18,0,0,8" VerticalAlignment="Center"
                                  ToolTip="Décochez pour revenir à l'ordre de saisie des opérations"
                                  Visibility="{Binding ACategories, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                           Text="{Binding AideOperations}" />

                <!-- Liste remplie par le code (VueMois.xaml.cs) : regroupée par catégorie ou dans l'ordre de saisie. -->
                <DataGrid x:Name="GrilleOperations" SelectedItem="{Binding Operations.Selection}">
                    <!-- Ligne pointée (à la main ou par l'import d'un relevé) : surlignée en vert. -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pointee}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent2Clair}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <!-- Bandeau de chaque catégorie : sa couleur, son nom et son total. -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Margin="0,8,0,2" Padding="10,4" CornerRadius="6" Background="{DynamicResource LigneAlternee}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Margin="0,0,8,0"
                                                       Text="{Binding Items[0].TotalCategorie, Converter={StaticResource Euros}}" />
                                            <Border Width="12" Height="12" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="{Binding Items[0].CouleurGroupe}" />
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' · {0} opération(s)'}" Style="{StaticResource Discret}"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Pointé" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Pointee, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE896;" FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource Accent1}" ToolTip="Importée du relevé bancaire"
                                                   Visibility="{Binding Importee, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Libellé" Binding="{Binding Libelle}" Width="*" MinWidth="160"
                                            ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}" />
                        <DataGridTemplateColumn x:Name="ColonneCategorie" Header="Catégorie" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="5" Margin="2,4,4,4" CornerRadius="2"
                                                Background="{Binding CouleurBande}" />
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.NomsCategories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Enveloppe" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource ListeCellule}"
                                              ItemsSource="{Binding DataContext.NomsEnveloppes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Enveloppe, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Compte cumulé" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource ListeCellule}"
                                              ItemsSource="{Binding DataContext.NomsComptesCumul, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding CompteCumul, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColonneVirement" Header="Virement avec" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding InfoLien}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icone}" Text="&#xE8AB;" FontSize="11" Margin="4,0,2,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Accent1}"
                                                   Visibility="{Binding EstLie, Converter={StaticResource Visible}}" />
                                        <ComboBox Style="{StaticResource ListeCellule}"
                                                  ItemsSource="{Binding DataContext.Comptes.Noms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding CompteLie, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Débit" Width="95"
                                            Binding="{Binding Debit, Converter={StaticResource Montant}, ConverterParameter=vide}"
                                            ElementStyle="{StaticResource CelluleMontant}"
                                            EditingElementStyle="{StaticResource EditionMontant}" />
                        <DataGridTextColumn Header="Crédit" Width="95"
                                            Binding="{Binding Credit, Converter={StaticResource Montant}, ConverterParameter=vide}"
                                            EditingElementStyle="{StaticResource EditionMontant}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                    <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Solde" Width="105" IsReadOnly="True"
                                            Binding="{Binding Solde, Mode=OneWay, Converter={StaticResource Montant}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoldeNegatif}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Colonne de droite : détail du solde et comptes cumulés -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                            <TextBlock Text="Détail du solde" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Ancien solde" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AncienSolde, Converter={StaticResource Euros}}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="+ Revenus" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalRevenus, Converter={StaticResource Euros}}"
                                       Foreground="{DynamicResource Positif}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="= Solde de départ" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SoldeDepart, Converter={StaticResource Euros}}"
                                       FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="− Réservé (enveloppes)" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalReserveEnveloppes, Converter={StaticResource Euros}}"
                                       Foreground="{DynamicResource Accent3}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Text="− Débits" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalDebits, Converter={StaticResource Euros}}"
                                       Foreground="{DynamicResource Accent3}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Text="+ Crédits" Style="{StaticResource Discret}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalCredits, Converter={StaticResource Euros}}"
                                       Foreground="{DynamicResource Positif}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Background="{DynamicResource Accent1Clair}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock Text="Fin de mois" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SoldeFin, Converter={StaticResource Euros}}" HorizontalAlignment="Right" FontSize="20">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="{DynamicResource Accent1}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SoldeFinNegatif}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Carte}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent4}" />
                            <TextBlock Text="Comptes cumulés" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Aide}" Text="Total depuis le début, ce mois inclus." />
                        <ItemsControl ItemsSource="{Binding ComptesCumul}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,12">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Total, Converter={StaticResource Euros}}"
                                                       FontWeight="Bold" Foreground="{DynamicResource Accent4}" />
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Progression, Mode=OneWay}" Maximum="100" Height="8" Margin="0,6,0,3"
                                                     Foreground="{DynamicResource Accent4}"
                                                     Visibility="{Binding AObjectif, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Style="{StaticResource Discret}"
                                                   Visibility="{Binding AObjectif, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

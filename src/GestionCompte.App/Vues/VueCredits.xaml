<UserControl x:Class="GestionCompte.App.Vues.VueCredits"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Racine">
    <UserControl.Resources>
        <Style x:Key="Tuile" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ValeurTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SousTitre" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="18,12" Margin="6,6,6,4">
            <StackPanel>
                <TextBlock Text="Crédits" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource EnteteTexte}" />
                <TextBlock Text="Simulez et comparez des crédits, puis ajoutez les échéances au prévisionnel. Tout est calculé sur votre PC."
                           Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" FontSize="12" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Border Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Button ToolTip="Ajouter une simulation" Command="{Binding Liste.AjouterCommand}"
                                    Style="{StaticResource BoutonPrincipal}" Padding="0" Width="30" Height="28">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE710;" FontSize="11" />
                            </Button>
                            <Button ToolTip="Supprimer la simulation sélectionnée" Command="{Binding Liste.SupprimerCommand}"
                                    Padding="0" Width="30" Height="28">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE74D;" FontSize="12" />
                            </Button>
                            <Button ToolTip="Monter" Command="{Binding Liste.MonterCommand}" Padding="0" Width="28" Height="28">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE70E;" FontSize="11" />
                            </Button>
                            <Button ToolTip="Descendre" Command="{Binding Liste.DescendreCommand}" Padding="0" Width="28" Height="28" Margin="0">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE70D;" FontSize="11" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                            <TextBlock Text="Simulation de crédit" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                               Text="Immobilier, auto / moto ou consommation : ajoutez plusieurs simulations pour les comparer (durée, taux, assurance). Sélectionnez-en une pour voir son détail." />

                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Liste.Elements}" SelectedItem="{Binding Liste.Selection}" Height="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Simulation" Binding="{Binding Nom}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource CelluleTexte}" EditingElementStyle="{StaticResource EditionTexte}" />
                            <DataGridTemplateColumn Header="Type" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Montant" Width="95" Binding="{Binding Montant, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}" EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTextColumn Header="Taux %" Width="60" Binding="{Binding TauxAnnuel, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}" EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTextColumn Header="Durée" Width="52" Binding="{Binding Duree}"
                                                ElementStyle="{StaticResource CelluleMontant}" EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTemplateColumn Header="" Width="62">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" SelectedItem="{Binding Unite, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.Unites, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Assurance" Width="72" Binding="{Binding Assurance, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}" EditingElementStyle="{StaticResource EditionMontant}" />
                            <DataGridTemplateColumn Header="" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" SelectedItem="{Binding TypeAssurance, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.TypesAssurance, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="1re échéance" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{StaticResource ListeCellule}" SelectedItem="{Binding PremiereEcheance, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.Periodes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Mensualité" Width="90" IsReadOnly="True"
                                                Binding="{Binding Mensualite, Mode=OneWay, Converter={StaticResource Montant}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Coût total" Width="90" IsReadOnly="True"
                                                Binding="{Binding CoutTotal, Mode=OneWay, Converter={StaticResource Montant}}"
                                                ElementStyle="{StaticResource CelluleMontant}" />
                            <DataGridTextColumn Header="Endettement" Width="85" IsReadOnly="True" Binding="{Binding TauxEndettement, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                        <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EndettementExcessif}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Prévisionnel" Width="105" IsReadOnly="True" Binding="{Binding EtatPrevisionnel, Mode=OneWay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleTexte}">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent1}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Margin="0,12,0,0" Visibility="{Binding ASelection, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,6">
                                <Run Text="Tableau d'amortissement :" />
                                <Run Text="{Binding Selection.Nom, Mode=OneWay}" />
                                <Run Text="{Binding Selection.DureeTexte, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource TexteDiscret}" />
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding Selection.Tableau}" IsReadOnly="True" Height="440" VerticalAlignment="Top">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="N°" Binding="{Binding Numero}" Width="46" ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Mois" Binding="{Binding Periode.Libelle}" Width="*" ElementStyle="{StaticResource CelluleTexte}" />
                                    <DataGridTextColumn Header="Mensualité" Width="95" Binding="{Binding Mensualite, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Capital" Width="95" Binding="{Binding Capital, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Intérêts" Width="90" Binding="{Binding Interets, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Assurance" Width="85" Binding="{Binding Assurance, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                    <DataGridTextColumn Header="Restant dû" Width="110" Binding="{Binding CapitalRestant, Converter={StaticResource Montant}}"
                                                        ElementStyle="{StaticResource CelluleMontant}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent1}">
                                <StackPanel>
                                    <TextBlock Text="Mensualité (assurance comprise)" Style="{StaticResource Discret}" FontSize="12" />
                                    <TextBlock Text="{Binding Selection.Mensualite, Converter={StaticResource Euros}}" Style="{StaticResource ValeurTuile}"
                                               Foreground="{DynamicResource Accent1}" />
                                    <TextBlock Style="{StaticResource Discret}">
                                        <Run Text="{Binding Selection.MensualiteHorsAssurance, Mode=OneWay, Converter={StaticResource Euros}}" />
                                        <Run Text="+ assurance" />
                                        <Run Text="{Binding Selection.AssuranceMensuelle, Mode=OneWay, Converter={StaticResource Euros}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent3}">
                                <StackPanel>
                                    <TextBlock Text="Coût total du crédit" Style="{StaticResource Discret}" FontSize="12" />
                                    <TextBlock Text="{Binding Selection.CoutTotal, Converter={StaticResource Euros}}" Style="{StaticResource ValeurTuile}"
                                               Foreground="{DynamicResource Accent3}" />
                                    <TextBlock Style="{StaticResource Discret}">
                                        <Run Text="intérêts" />
                                        <Run Text="{Binding Selection.CoutInterets, Mode=OneWay, Converter={StaticResource Euros}}" />
                                        <Run Text="+ assurance" />
                                        <Run Text="{Binding Selection.CoutAssurance, Mode=OneWay, Converter={StaticResource Euros}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent2}">
                                <StackPanel>
                                    <TextBlock Text="Endettement et reste par mois" Style="{StaticResource Discret}" FontSize="12" />
                                    <TextBlock>
                                        <Run Text="{Binding Selection.TauxEndettement, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                                        <Run Text="  —  reste" Foreground="{DynamicResource TexteDiscret}" />
                                        <Run Text="{Binding Selection.ResteApres, Mode=OneWay, Converter={StaticResource Euros}}" FontWeight="Bold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selection.ResteNegatif}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run>
                                        <Run Text="/ mois" Foreground="{DynamicResource TexteDiscret}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Selection.DetailEndettement}" Style="{StaticResource Discret}" TextWrapping="Wrap" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,10">
                                <Button Command="{Binding ExporterCommand}" ToolTip="Exporter le tableau d'amortissement vers Excel">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE896;" Margin="0,0,6,0" />
                                        <TextBlock Text="Excel" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Retirer" Command="{Binding RetirerDuPrevisionnelCommand}"
                                        ToolTip="Retirer les échéances du prévisionnel et des mois" />
                                <Button Content="Ajouter au prévisionnel" Command="{Binding AjouterAuPrevisionnelCommand}"
                                        Style="{StaticResource BoutonPrincipal}" Margin="0" />
                            </WrapPanel>
                            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent4}">
                                <StackPanel>
                                    <TextBlock Text="Combien puis-je emprunter ?" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                        <TextBlock Text="Pour" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBox Text="{Binding MensualiteMaximale, Converter={StaticResource Montant}}" Width="90" TextAlignment="Right" />
                                        <TextBlock Text="€ par mois" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ConditionsInverse}" Style="{StaticResource Discret}" TextWrapping="Wrap" />
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Content="Créer la simulation" Command="{Binding CreerDepuisMensualiteCommand}" Margin="0" />
                                        <TextBlock Text="{Binding MontantEmpruntable, Converter={StaticResource Euros}}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent4}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Taux du moment : Gemini et Mistral cherchent sur internet. -->
            <Border Style="{StaticResource Carte}" Visibility="{Binding ASelection, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BoutonPrincipal}" Command="{Binding ChercherTauxCommand}" Margin="0"
                                VerticalAlignment="Top" ToolTip="Gemini et Mistral cherchent les taux actuels sur internet">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE721;" Margin="0,0,6,0" />
                                <TextBlock Text="Chercher les taux du moment" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                            <TextBlock Text="Taux du moment" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Aide}" TextWrapping="Wrap">
                        <Run Text="Pour la simulation sélectionnée :" />
                        <Run Text="{Binding CategorieSelection, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=". Seule cette catégorie est envoyée aux IA, jamais vos montants ni vos chiffres." />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Aide}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding IADisponibles, Converter={StaticResource MasqueSiVrai}}"
                               Text="Saisissez une clé Gemini ou Mistral dans Configuration › Intelligence artificielle pour chercher les taux." />

                    <Border Background="{DynamicResource Negatif}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AlerteUsure}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AlerteUsure}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <Grid Margin="0,10,0,4" Visibility="{Binding AvecTaux, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IA" Style="{StaticResource Discret}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Bas" Style="{StaticResource Discret}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="Moyen" Style="{StaticResource Discret}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Haut" Style="{StaticResource Discret}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Usure (max.)" Style="{StaticResource Discret}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Assurance" Style="{StaticResource Discret}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Sources" Style="{StaticResource Discret}" FontWeight="SemiBold" Margin="16,0,0,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TauxTrouves}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Bordure}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Nom}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Periode}" Style="{StaticResource Discret}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Bas}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Moyen}" TextAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource Accent1}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Haut}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding Usure}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding Assurance}" TextAlignment="Right" />
                                        <DockPanel Grid.Column="6" Margin="16,0,0,0">
                                            <Button DockPanel.Dock="Right" Content="Reprendre le taux moyen" Margin="8,0,0,0" VerticalAlignment="Top"
                                                    Visibility="{Binding Reprenable, Converter={StaticResource Visible}}"
                                                    ToolTip="Met ce taux (et l'assurance, si elle est en % par an) dans la simulation sélectionnée"
                                                    Command="{Binding DataContext.ReprendreTauxCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                            <ItemsControl ItemsSource="{Binding Liens}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Nom}" Padding="8,2" Margin="0,0,4,4" FontSize="12" ToolTip="{Binding Adresse}"
                                                                Command="{Binding DataContext.OuvrirSourceCommand, ElementName=Racine}" CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ErreurTaux}" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatutTaux}" Style="{StaticResource Discret}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Aide}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Le taux d'usure est le TAEG maximum autorisé (Banque de France). Le TAEG de la simulation est estimé avec l'assurance, sans frais de dossier ni de garantie." />
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

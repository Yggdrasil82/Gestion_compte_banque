<UserControl x:Class="GestionCompte.App.Vues.VueImport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Compteur du résumé, avec un liseré de couleur à gauche. -->
        <Style x:Key="Compteur" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,10" />
        </Style>
        <Style x:Key="ValeurCompteur" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="LibelleCompteur" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Lignes déjà importées ou antérieures au premier mois : grisées. -->
        <Style x:Key="LigneImport" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Modifiable}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Importer}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Bandeau : fichier importé et actions. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="16,12" Margin="6,6,6,4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BoutonEntete}" Command="{Binding AnnulerCommand}"
                            ToolTip="Revenir sans rien modifier">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE711;" Margin="0,0,8,0" />
                            <TextBlock Text="Annuler" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BoutonEnteteBlanc}" Command="{Binding ValiderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE73E;" Margin="0,0,8,0" />
                            <TextBlock Text="Valider l'import" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Import du relevé" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource EnteteTexte}" />
                    <TextBlock Text="{Binding NomFichier}" Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Résumé -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.8*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Compteur}" BorderBrush="{DynamicResource Accent2}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LibelleCompteur}" Text="Rapprochées" />
                    <TextBlock Style="{StaticResource ValeurCompteur}" Foreground="{DynamicResource Accent2}" Text="{Binding NombreRapprochees}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Compteur}" BorderBrush="{DynamicResource Avertissement}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LibelleCompteur}" Text="Montants ajustés" />
                    <TextBlock Style="{StaticResource ValeurCompteur}" Foreground="{DynamicResource Avertissement}" Text="{Binding NombreAjustees}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Compteur}" BorderBrush="{DynamicResource Positif}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LibelleCompteur}" Text="Revenus reçus" />
                    <TextBlock Style="{StaticResource ValeurCompteur}" Foreground="{DynamicResource Positif}" Text="{Binding NombreRevenus}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Compteur}" BorderBrush="{DynamicResource Accent1}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LibelleCompteur}" Text="Nouvelles" />
                    <TextBlock Style="{StaticResource ValeurCompteur}" Foreground="{DynamicResource Accent1}" Text="{Binding NombreNouvelles}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Compteur}" BorderBrush="{DynamicResource TexteDiscret}">
                <StackPanel>
                    <TextBlock Style="{StaticResource LibelleCompteur}" Text="Ignorées" />
                    <TextBlock Style="{StaticResource ValeurCompteur}" Foreground="{DynamicResource TexteDiscret}" Text="{Binding NombreIgnorees}" />
                </StackPanel>
            </Border>

            <!-- Contrôle du solde : banque ↔ solde pointé de l'application. -->
            <Border Grid.Column="5" Style="{StaticResource Compteur}" BorderBrush="{DynamicResource Accent4}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LibelleCompteur}" VerticalAlignment="Center"
                               Text="{Binding DateSolde, StringFormat='Solde banque au {0}'}"
                               Visibility="{Binding ASoldeBanque, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" TextAlignment="Right"
                               Text="{Binding SoldeBanque, Converter={StaticResource Euros}}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource LibelleCompteur}" VerticalAlignment="Center"
                               Text="{Binding LibelleSoldePointe}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" TextAlignment="Right"
                               Text="{Binding SoldePointeApres, Converter={StaticResource Euros}}" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding SoldeConcorde, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE73E;" Foreground="{DynamicResource Positif}" Margin="0,0,6,0" />
                        <TextBlock Text="Les soldes concordent" Foreground="{DynamicResource Positif}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding SoldeDiffere, Converter={StaticResource Visible}}"
                                ToolTip="Opérations pointées avant l'import mais absentes du relevé, ou solde de départ à vérifier.">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" Foreground="{DynamicResource Avertissement}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Ecart, Converter={StaticResource Euros}, StringFormat='Écart : {0}'}"
                                   Foreground="{DynamicResource Avertissement}" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Rien à importer -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" BorderBrush="{DynamicResource Accent1}" Padding="14,8"
                Visibility="{Binding RienAImporter, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icone}" Text="&#xE946;" Foreground="{DynamicResource Accent1}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding MessageRienAImporter}" FontWeight="SemiBold" />
                <TextBlock Text=" Cliquez sur « Annuler » pour revenir." Style="{StaticResource Discret}" />
            </StackPanel>
        </Border>

        <!-- Mois à créer -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" BorderBrush="{DynamicResource Avertissement}" Padding="14,8"
                Visibility="{Binding AMoisACreer, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icone}" Text="&#xE787;" Foreground="{DynamicResource Avertissement}" Margin="0,0,10,0" />
                <TextBlock Text="Mois qui seront créés (après confirmation) : " />
                <TextBlock Text="{Binding MoisACreer}" FontWeight="SemiBold" />
            </StackPanel>
        </Border>

        <!-- Opérations datées d'un mois antérieur au mois en cours (chevauchement de relevé) -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Carte}" BorderBrush="{DynamicResource Avertissement}" Padding="14,8"
                Visibility="{Binding ADatesAnterieures, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RangerDatesAnterieuresCommand}" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE787;" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TexteRangement}" />
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" Foreground="{DynamicResource Avertissement}" Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding TexteDatesAnterieures}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Opérations du relevé -->
        <Border Style="{StaticResource Carte}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                    <TextBlock Text="Opérations du relevé" Style="{StaticResource TitreCarte}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Aide}"
                           Text="Vérifiez le rapprochement proposé pour chaque ligne : elle peut être rattachée à une opération prévue du mois (elle sera pointée avec le montant de la banque) ou ajoutée comme nouvelle opération. Décochez une ligne pour l'ignorer. Rien n'est modifié avant « Valider l'import »." />

                <DataGrid ItemsSource="{Binding Lignes}" RowStyle="{StaticResource LigneImport}" RowDetailsVisibilityMode="Visible">
                    <!-- Même montant déjà dans l'application (date antérieure) : la question s'affiche sous la ligne. -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="78,0,8,6"
                                        Visibility="{Binding AVerification, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE9CE;" Foreground="{DynamicResource Avertissement}"
                                           FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Verification}" Foreground="{DynamicResource Avertissement}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Importer" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Importer, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Modifiable}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Date antérieure au mois en cours : alerte orange. -->
                        <DataGridTemplateColumn Header="Date" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding AlerteDate}">
                                        <TextBlock Text="{Binding Date}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleTexte}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DateAnterieure}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Avertissement}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" Foreground="{DynamicResource Avertissement}"
                                                   FontSize="13" Margin="2,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding DateAnterieure, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Mois" Width="135">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding MoisChoisi, Mode=OneWay}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleTexte}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MoisModifiable}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{Binding ChoixMois}"
                                                  SelectedItem="{Binding MoisChoisi, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="{Binding AlerteDate}"
                                                  Visibility="{Binding MoisModifiable, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Libellé" Width="*" MinWidth="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource CelluleTexte}" Text="{Binding Libelle}" ToolTip="{Binding LibelleBanque}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Montant" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Montant, Converter={StaticResource Euros}}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
                                                <Setter Property="Foreground" Value="{DynamicResource Texte}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EstCredit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Positif}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Statut" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left" Margin="4,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Bordure}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatutTexte}" Value="Rapprochée">
                                                        <Setter Property="Background" Value="{DynamicResource Accent2}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutTexte}" Value="Montant ajusté">
                                                        <Setter Property="Background" Value="{DynamicResource Avertissement}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutTexte}" Value="Revenu reçu">
                                                        <Setter Property="Background" Value="{DynamicResource Positif}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutTexte}" Value="Nouvelle">
                                                        <Setter Property="Background" Value="{DynamicResource Accent1}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatutTexte}" Value="À vérifier">
                                                        <Setter Property="Background" Value="{DynamicResource Avertissement}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatutTexte}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Rattachée à" Width="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource ListeCellule}" ItemsSource="{Binding Options}" IsEnabled="{Binding Modifiable}"
                                              SelectedItem="{Binding OptionChoisie, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Enveloppe" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource ListeCellule}" IsEnabled="{Binding EnveloppeModifiable}"
                                              ItemsSource="{Binding DataContext.NomsEnveloppes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Enveloppe, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Règle" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding RetenirRegle, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"
                                              Visibility="{Binding PeutRetenirRegle, Converter={StaticResource Visible}}"
                                              ToolTip="{Binding TexteRegle}">
                                        <TextBlock Text="{Binding MotCleSuggere, StringFormat='Retenir « {0} »'}" TextTrimming="CharacterEllipsis" />
                                    </CheckBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

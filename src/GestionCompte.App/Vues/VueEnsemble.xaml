<UserControl x:Class="GestionCompte.App.Vues.VueEnsemble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:GestionCompte.App">
    <UserControl.Resources>
        <Style x:Key="Tuile" TargetType="Border" BasedOn="{StaticResource Carte}">
            <Setter Property="BorderThickness" Value="5,1,1,1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="IconeTuile" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="LibelleTuile" TargetType="TextBlock" BasedOn="{StaticResource Discret}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ValeurTuile" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="MontantCellule" TargetType="TextBlock" BasedOn="{StaticResource CelluleMontant}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource Entete}" CornerRadius="14" Padding="18,12" Margin="6,6,6,4">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Vue d'ensemble" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource EnteteTexte}" />
                <TextBlock Text="Tous vos comptes réunis. Les mois pas encore créés sont simulés comme dans le prévisionnel de chaque compte."
                           Foreground="{DynamicResource EnteteTexte}" Opacity="0.85" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Chiffres clés -->
        <UniformGrid DockPanel.Dock="Top" Rows="1">
            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent1}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent1Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE8C7;" FontSize="18" Foreground="{DynamicResource Accent1}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding MoisActuel, StringFormat='Total fin {0}'}" />
                        <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent1}"
                                   Text="{Binding TotalActuel, Converter={StaticResource Euros}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent4}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent4Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xEAFC;" FontSize="18" Foreground="{DynamicResource Accent4}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding MoisFin, StringFormat='Total fin {0}'}" />
                        <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent4}"
                                   Text="{Binding TotalFin, Converter={StaticResource Euros}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent3}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent3Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE74B;" FontSize="18" Foreground="{DynamicResource Accent3}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="{Binding MoisPointBas, StringFormat='Point le plus bas ({0})'}" />
                        <TextBlock Text="{Binding PointBasTotal, Converter={StaticResource Euros}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ValeurTuile}">
                                    <Setter Property="Foreground" Value="{DynamicResource Accent3}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalNegatif}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tuile}" BorderBrush="{DynamicResource Accent2}"
                    Visibility="{Binding ABourse, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource IconeTuile}" Background="{DynamicResource Accent2Clair}">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE9D2;" FontSize="18" Foreground="{DynamicResource Accent2}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LibelleTuile}" Text="Placements en bourse" />
                        <TextBlock Style="{StaticResource ValeurTuile}" Foreground="{DynamicResource Accent2}"
                                   Text="{Binding TotalBourse, Converter={StaticResource Euros}}" />
                        <TextBlock Style="{StaticResource LibelleTuile}">
                            <Run Text="Avec les comptes :" />
                            <Run Text="{Binding Patrimoine, Mode=OneWay, Converter={StaticResource Euros}}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Comptes -->
            <Border Grid.Row="0" Style="{StaticResource Carte}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent2}" />
                        <TextBlock Text="Vos comptes" Style="{StaticResource TitreCarte}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Lignes}" IsReadOnly="True" DataContextChanged="DonneesChangees">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Compte" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,0">
                                            <TextBlock Text="{Binding Nom}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Actif}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Border CornerRadius="8" Padding="7,1" Margin="8,0,0,0" Background="{DynamicResource Accent1}"
                                                    Visibility="{Binding Actif, Converter={StaticResource Visible}}">
                                                <TextBlock Text="ouvert" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Fin du mois en cours"
                                                Width="150" Binding="{Binding SoldeActuel, Converter={StaticResource Euros}}"
                                                ElementStyle="{StaticResource MontantCellule}" />
                            <DataGridTextColumn Header="Évolution" Width="120" Binding="{Binding Variation, Converter={StaticResource Euros}}"
                                                ElementStyle="{StaticResource CelluleMontant}" />
                            <DataGridTextColumn Header="Fin sur 12 mois" Width="150" Binding="{Binding SoldeFin, Converter={StaticResource Euros}}"
                                                ElementStyle="{StaticResource MontantCellule}" />
                            <DataGridTextColumn x:Name="ColonneBourse" Header="Bourse" Width="130"
                                                Binding="{Binding Bourse, Converter={StaticResource Euros}}"
                                                ElementStyle="{StaticResource MontantCellule}" />
                            <DataGridTemplateColumn Header="Point le plus bas" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Run Text="{Binding PointBas, Mode=OneWay, Converter={StaticResource Euros}}" FontWeight="SemiBold" />
                                            <Run Text="{Binding MoisPointBas, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource TexteDiscret}" />
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PointBasNegatif}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Negatif}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0" Foreground="{DynamicResource Avertissement}"
                               Text="{Binding Illisibles}" Visibility="{Binding AIllisibles, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource Aide}" Margin="0,8,0,0"
                               Text="Changez de compte avec la liste en haut à gauche. Les virements entre vos comptes se saisissent dans chacun des deux comptes." />
                </StackPanel>
            </Border>

            <!-- Total mois par mois -->
            <Border Grid.Row="1" Style="{StaticResource Carte}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Border Width="18" Height="3" Background="{DynamicResource Accent1}" VerticalAlignment="Center" />
                            <TextBlock Text="réel" Style="{StaticResource Discret}" Margin="6,0,14,0" />
                            <TextBlock Text="• • •" Foreground="{DynamicResource Accent1}" FontWeight="Bold" />
                            <TextBlock Text="prévu" Style="{StaticResource Discret}" Margin="6,0,14,0" />
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Negatif}" VerticalAlignment="Center" />
                            <TextBlock Text="négatif" Style="{StaticResource Discret}" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource PuceTitre}" Background="{DynamicResource Accent1}" />
                            <TextBlock Text="Total de tous les comptes, fin de mois" Style="{StaticResource TitreCarte}" />
                        </StackPanel>
                    </DockPanel>
                    <app:GraphiqueSoldes Lignes="{Binding Courbe}" MinHeight="220"
                                         Couleur="{DynamicResource Accent1}" CouleurNegative="{DynamicResource Negatif}"
                                         CouleurGrille="{DynamicResource Bordure}" CouleurTexte="{DynamicResource TexteDiscret}"
                                         CouleurFond="{DynamicResource FondCarte}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

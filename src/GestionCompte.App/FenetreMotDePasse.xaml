<Window x:Class="GestionCompte.App.FenetreMotDePasse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fond}" Foreground="{DynamicResource Texte}"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="Message" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBlock Text="Mot de passe" Style="{StaticResource Discret}" Margin="0,0,0,3" />
        <PasswordBox x:Name="Saisie" Height="28" Padding="4,3" VerticalContentAlignment="Center"
                     Background="{DynamicResource Saisie}" Foreground="{DynamicResource Texte}" BorderBrush="{DynamicResource Bordure}" />
        <StackPanel x:Name="ZoneConfirmation">
            <TextBlock Text="Confirmer le mot de passe" Style="{StaticResource Discret}" Margin="0,10,0,3" />
            <PasswordBox x:Name="Confirmation" Height="28" Padding="4,3" VerticalContentAlignment="Center"
                         Background="{DynamicResource Saisie}" Foreground="{DynamicResource Texte}" BorderBrush="{DynamicResource Bordure}" />
        </StackPanel>
        <TextBlock x:Name="Probleme" Foreground="{DynamicResource Negatif}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="16,7" />
            <Button Content="OK" Style="{StaticResource BoutonPrincipal}" IsDefault="True" Padding="16,7" Margin="0" Click="Valider" />
        </StackPanel>
    </StackPanel>
</Window>
